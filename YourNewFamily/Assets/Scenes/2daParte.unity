    dialogueText: "Promet\xED que nadie las volver\xEDa a tocar. Y m\xEDralas. Yo
      iba a sacarlas de aqu\xED ma\xF1ana."
    leftSpeaker: 1
    characterSprite: {fileID: 1671261912145405086, guid: d279c746e1995de44be23bb026a9d9ad, type: 3}
