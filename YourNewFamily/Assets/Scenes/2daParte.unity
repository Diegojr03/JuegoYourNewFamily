  spriteRight: {fileID: 2025212325}
  defaultLeftSprite: {fileID: -898178471685318745, guid: f70003e8f5ccb6d4d8c511e0e27bd740, type: 3}
  defaultRightSprite: {fileID: -1674950913012282259, guid: 44412b1d030bb9c40b08a3042c899310, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogues:
  - speakerName: Cael
    dialogueText: Lilith, encantado de conocerte. Mira, necesito que vayas al invernadero,
      dile a Nira que necesito hoja dulce.
    leftSpeaker: 1
    characterSprite: {fileID: -2472076170658201133, guid: 59c59bfd50dc2804cb457b9268ca8d4c, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cael
    dialogueText: La mezcla huele incompleta, y no pienso permitir que un detalle
      tan trivial arruine mi trabajo.
    leftSpeaker: 1
    characterSprite: {fileID: -2472076170658201133, guid: 59c59bfd50dc2804cb457b9268ca8d4c, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cael
    dialogueText: "D\xEDselo de mi parte. Ella entender\xE1 la urgencia"
    leftSpeaker: 1
    characterSprite: {fileID: -2472076170658201133, guid: 59c59bfd50dc2804cb457b9268ca8d4c, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
