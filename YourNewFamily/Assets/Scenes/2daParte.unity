MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1920329084}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58c785d1312487d48bae41c65e986f1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterLeft: {fileID: 1647079968}
  characterRight: {fileID: 2053032375}
  spriteLeft: {fileID: 1647079969}
  spriteRight: {fileID: 2053032376}
  defaultLeftSprite: {fileID: 8379664347739615351, guid: 79502e6f2b7c2fc4db01211d2366d4c1, type: 3}
  defaultRightSprite: {fileID: 3648207892980098720, guid: 0c6a7482622f9b3428899aa606073ac2, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogueId: af058c71-cfeb-436c-bf01-3866b975d121
  dialogues:
  - speakerName: Alpha
    dialogueText: "Est\xE1s m\xE1s preparada de lo que pensaba Has cambiado mucho
      desde que llegaste En cuanto a Delta\u2026 Siempre fue un hombre leal."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Eso es lo que hace fuerte a una familia. Personas capaces de darlo
      todo\u2026 sin dudar. Lo hiciste bien Lilith."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Ahora necesitamos ocuparnos de esto. Ll\xE9vate el cuerpo. Hay
      una sala a la derecha del trono."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "D\xE9jalo all\xED. Despu\xE9s vuelve. A\xFAn quedan partes de
      la profec\xEDa por cumplir. Y l\xEDmpiate esa sangre."
    leftSpeaker: 0
    characterSprite: {fileID: 6471638616864330708, guid: bbb9b4119138bfc418c8bdf3c7807b1a, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: De acuerdo, Alpha.
    leftSpeaker: 0
    characterSprite: {fileID: 6471638616864330708, guid: bbb9b4119138bfc418c8bdf3c7807b1a, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
  inventoryItemName: Nuevo Item
  objectsToActivateAfter:
  - {fileID: 354944245}
  objectsToDestroyAfter: []
  destroyAfterDialogue: 1
  autoActivate: 1
  reuseDelay: 0.5
