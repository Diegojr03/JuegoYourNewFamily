--- !u!114 &1272810746
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1272810744}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58c785d1312487d48bae41c65e986f1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterLeft: {fileID: 651177962}
  characterRight: {fileID: 852123575}
  spriteLeft: {fileID: 651177963}
  spriteRight: {fileID: 852123576}
  defaultLeftSprite: {fileID: 2254904283701343870, guid: cebec0d58053dfa4d93867dae2b40fc3, type: 3}
  defaultRightSprite: {fileID: -1674950913012282259, guid: 44412b1d030bb9c40b08a3042c899310, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogues:
  - speakerName: Cairen
    dialogueText: "Cuando \xE9ramos peque\xF1os\u2026 Yo os promet\xED que nada malo
      os iba a pasar."
    leftSpeaker: 1
    characterSprite: {fileID: 6775278750140180628, guid: 4996e8616930a4947817a517bd018a82, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "No sab\xEDa lo que dec\xEDa. Pero desde entonces\u2026 todo lo
      que hago es intentar que esa mentira no me desborde."
    leftSpeaker: 1
    characterSprite: {fileID: 6775278750140180628, guid: 4996e8616930a4947817a517bd018a82, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Jesal
    dialogueText: Siempre dices eso como si fuera tu culpa.
    leftSpeaker: 1
    characterSprite: {fileID: -325410527933720274, guid: 24dbb70e582dffd48822c8c6bfb8a87a, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "Porque lo es. Aqu\xED dicen que este sitio cuida de la gente rota."
    leftSpeaker: 1
    characterSprite: {fileID: 6775278750140180628, guid: 4996e8616930a4947817a517bd018a82, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Jase
    dialogueText: No estamos rotas.
    leftSpeaker: 1
    characterSprite: {fileID: 6338595484634577757, guid: 7c1ff9b99d9c10a4f886c428444eb1fe, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "No. Ma\xF1ana nos vamos."
    leftSpeaker: 1
    characterSprite: {fileID: 6775278750140180628, guid: 4996e8616930a4947817a517bd018a82, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: Bueno tampoco hace falta eso Cairen...
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: 2fd71506cd35b37499404742fc662a69, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Jesal
    dialogueText: "Lilith tiene raz\xF3n, \xBFest\xE1s seguro?"
    leftSpeaker: 1
    characterSprite: {fileID: -325410527933720274, guid: 24dbb70e582dffd48822c8c6bfb8a87a, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: Lo estoy chicas.
    leftSpeaker: 1
    characterSprite: {fileID: 6775278750140180628, guid: 4996e8616930a4947817a517bd018a82, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Jesal
    dialogueText: "Pero Cairen tu amas este sitio, \xBFseguro que estar\xE1s bien?"
    leftSpeaker: 1
    characterSprite: {fileID: -325410527933720274, guid: 24dbb70e582dffd48822c8c6bfb8a87a, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: Eso no importa
    leftSpeaker: 1
    characterSprite: {fileID: 6775278750140180628, guid: 4996e8616930a4947817a517bd018a82, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Jase
    dialogueText: "S\xED, s\xED que importa."
    leftSpeaker: 1
    characterSprite: {fileID: 6338595484634577757, guid: 7c1ff9b99d9c10a4f886c428444eb1fe, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Cairen, de verdad, pi\xE9nsalo bien."
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: 2fd71506cd35b37499404742fc662a69, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "Estar\xE9 bien si vosotras est\xE1is bien. Eso es todo lo que
      necesito. Lilith, estoy seguro que t\xFA entiendes lo que es no encajar aqu\xED."
    leftSpeaker: 1
    characterSprite: {fileID: 6775278750140180628, guid: 4996e8616930a4947817a517bd018a82, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "Lo veo en c\xF3mo miras alrededor, como si siempre estuvieras
      pidiendo permiso para respirar. Si quieres puedes venir con nosotros. Empezaremos
      de cero."
    leftSpeaker: 1
    characterSprite: {fileID: 6775278750140180628, guid: 4996e8616930a4947817a517bd018a82, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Jesal
    dialogueText: "Podr\xEDamos aprender a hacer pan de verdad. No el de aqu\xED."
    leftSpeaker: 1
    characterSprite: {fileID: -325410527933720274, guid: 24dbb70e582dffd48822c8c6bfb8a87a, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Jase
    dialogueText: Y dormir sin que alguien te observe.
    leftSpeaker: 1
    characterSprite: {fileID: 6338595484634577757, guid: 7c1ff9b99d9c10a4f886c428444eb1fe, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "Empezar\xE9 a trabajar. Estoy decidido. Mientras teng\xE1is una
      vida mejor que todo esto."
    leftSpeaker: 1
    characterSprite: {fileID: -7517056936566813833, guid: 432576f5d3f550b48809ee9457d15b53, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "Piensatelo Lilith. Ma\xF1ana, al amanecer, estaremos en la entrada."
    leftSpeaker: 1
    characterSprite: {fileID: -7517056936566813833, guid: 432576f5d3f550b48809ee9457d15b53, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Lo pensar\xE9."
    leftSpeaker: 0
    characterSprite: {fileID: 6377917850455477399, guid: b3555c8a1e4ebba4e84c64c3e0c1ec36, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
  inventoryItemName: Nuevo Item
