--- !u!114 &53011324
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 53011319}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58c785d1312487d48bae41c65e986f1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterLeft: {fileID: 1829065508}
  characterRight: {fileID: 301201509}
  spriteLeft: {fileID: 1829065509}
  spriteRight: {fileID: 301201510}
  defaultLeftSprite: {fileID: 7101044242358493641, guid: 0c34a2ac23cef364db5433cf4854f924, type: 3}
  defaultRightSprite: {fileID: -1674950913012282259, guid: 44412b1d030bb9c40b08a3042c899310, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogues:
  - speakerName: Lin
    dialogueText: "Gracias\u2026 gracias por traer todo. La tela, la piedra\u2026
      todo."
    leftSpeaker: 1
    characterSprite: {fileID: -4920136608581562092, guid: 3687bfad6f495db4d90baf3fbf03ad8e, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "No ha sido nada, Lin. Lo que sea para que el bebe est\xE9 bien\u2026
      y por Amara."
    leftSpeaker: 0
    characterSprite: {fileID: 6377917850455477399, guid: b3555c8a1e4ebba4e84c64c3e0c1ec36, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lin
    dialogueText: "S\xED\u2026 s\xED, eso es\u2026 Yo\u2026 quiero que esta manta
      sea especial."
    leftSpeaker: 1
    characterSprite: {fileID: -4920136608581562092, guid: 3687bfad6f495db4d90baf3fbf03ad8e, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lin
    dialogueText: "Para que Amara vea que pienso en mi hijo\u2026 y para que est\xE9
      protegido\u2026 con la Safira."
    leftSpeaker: 1
    characterSprite: {fileID: -4920136608581562092, guid: 3687bfad6f495db4d90baf3fbf03ad8e, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: Seguro que Amara lo va a valorar mucho. Es un regalo precioso.
    leftSpeaker: 0
    characterSprite: {fileID: 6377917850455477399, guid: b3555c8a1e4ebba4e84c64c3e0c1ec36, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lin
    dialogueText: "\xBFT\xFA\u2026 crees? A veces siento que\u2026 que hago todo
      mal. Pero\u2026 esto\u2026 esto quiero que sea bueno."
    leftSpeaker: 1
    characterSprite: {fileID: -4920136608581562092, guid: 3687bfad6f495db4d90baf3fbf03ad8e, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: Has hecho todo lo posible, Lin. Y con cuidado, eso es lo que cuenta.
    leftSpeaker: 0
    characterSprite: {fileID: 6377917850455477399, guid: b3555c8a1e4ebba4e84c64c3e0c1ec36, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lin
    dialogueText: "S\xED\u2026 s\xED\u2026 gracias, Lilith. De verdad. No s\xE9\u2026
      no s\xE9 c\xF3mo habr\xEDa hecho esto sin ti."
    leftSpeaker: 1
    characterSprite: {fileID: -4920136608581562092, guid: 3687bfad6f495db4d90baf3fbf03ad8e, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lin
    dialogueText: "Amara\u2026 estar\xE1 feliz. Y yo\u2026 me siento un poco menos
      in\xFAtil."
    leftSpeaker: 1
    characterSprite: {fileID: -4920136608581562092, guid: 3687bfad6f495db4d90baf3fbf03ad8e, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
