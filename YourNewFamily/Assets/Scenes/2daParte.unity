MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1955075351}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58c785d1312487d48bae41c65e986f1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterLeft: {fileID: 688821436}
  characterRight: {fileID: 1726581660}
  spriteLeft: {fileID: 688821437}
  spriteRight: {fileID: 1726581661}
  defaultLeftSprite: {fileID: -4619670943869267955, guid: dbdb86a0b27d8d94a9d152fe45632273, type: 3}
  defaultRightSprite: {fileID: 3648207892980098720, guid: 0c6a7482622f9b3428899aa606073ac2, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogueId: a8af820b-5bee-4925-aae3-bf485a340801
  dialogues:
  - speakerName: Delta
    dialogueText: Lilith.
    leftSpeaker: 1
    characterSprite: {fileID: -311131714167770203, guid: 97fa321f5b36dfa46bc8e7c875e1c5c3, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: 'LIlith '
    dialogueText: Tengo que ver a Alpha.
    leftSpeaker: 0
    characterSprite: {fileID: 6471638616864330708, guid: bbb9b4119138bfc418c8bdf3c7807b1a, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Delta
    dialogueText: No.
    leftSpeaker: 1
    characterSprite: {fileID: -311131714167770203, guid: 97fa321f5b36dfa46bc8e7c875e1c5c3, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: Ha pasado algo.
    leftSpeaker: 0
    characterSprite: {fileID: 6471638616864330708, guid: bbb9b4119138bfc418c8bdf3c7807b1a, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Delta
    dialogueText: "Lo s\xE9, ve a la enfermer\xEDa de Cael. Ahora."
    leftSpeaker: 1
    characterSprite: {fileID: -311131714167770203, guid: 97fa321f5b36dfa46bc8e7c875e1c5c3, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: Pero estoy toda manchada de sangre.
    leftSpeaker: 0
    characterSprite: {fileID: 6471638616864330708, guid: bbb9b4119138bfc418c8bdf3c7807b1a, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Delta
    dialogueText: "Di que te has tropezado. Para llegar a la enfermer\xEDa pasa por
      la biblioteca."
    leftSpeaker: 1
    characterSprite: {fileID: -311131714167770203, guid: 97fa321f5b36dfa46bc8e7c875e1c5c3, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Pero... \xBFy Lin?"
    leftSpeaker: 0
    characterSprite: {fileID: 6471638616864330708, guid: bbb9b4119138bfc418c8bdf3c7807b1a, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Delta
    dialogueText: "Yo me encargo de todo. Ve. T\xF3mate esto, te vendr\xE1 bien.\r"
    leftSpeaker: 1
    characterSprite: {fileID: -311131714167770203, guid: 97fa321f5b36dfa46bc8e7c875e1c5c3, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: 
    dialogueText: "*Bebes el n\xE9ctar que te ha dado Delta*\r  "
    leftSpeaker: 0
    characterSprite: {fileID: 8244233600422226293, guid: 2cc7b826e07bb0649861f6e95b99933c, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: Gracias Delta.
    leftSpeaker: 0
    characterSprite: {fileID: -1974585017840102121, guid: 81330c24c3a3365428d1996277c75326, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
  inventoryItemName: Nuevo Item
