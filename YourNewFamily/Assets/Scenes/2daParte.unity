  defaultRightSprite: {fileID: -1674950913012282259, guid: a5603edeb1e5a3d45a5e2ebd1a655387, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogueId: dc1c2653-22f4-4eec-866c-1a802bd6ae67
  dialogues:
  - speakerName: Lilith
    dialogueText: "Amara, mira, lo encontr\xE9. Estaba escondido detr\xE1s de unas
      cajas en un granero."
    leftSpeaker: 0
    characterSprite: {fileID: -3582710704502222356, guid: 03b328f3d751c38429f3af6a3895348b, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Amara
    dialogueText: "\xA1Nube! Ay qu\xE9 alivio. Gracias, Lilith. En serio, no s\xE9
      qu\xE9 habr\xEDa hecho si\u2026"
    leftSpeaker: 1
    characterSprite: {fileID: -2145651702438150279, guid: 6807f1ca35c956741a3c9db6d09bd8d7, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Amara
    dialogueText: "De verdad, significas m\xE1s para m\xED de lo que crees. Gracias
      por ayudarme."
    leftSpeaker: 1
    characterSprite: {fileID: -2145651702438150279, guid: 6807f1ca35c956741a3c9db6d09bd8d7, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: Muchas gracias Amara.
    leftSpeaker: 0
    characterSprite: {fileID: 6377917850455477399, guid: 25e65e92d43918b438de921ced967a6a, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
