  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogues:
  - speakerName: Lilith
    dialogueText: "Amara, mira, lo encontr\xE9. Estaba escondido detr\xE1s de unas
      cajas en un granero."
    leftSpeaker: 0
    characterSprite: {fileID: 6078937715035284617, guid: 3b75265a4a27f5a4fb33fc22daf3f5f1, type: 3}
