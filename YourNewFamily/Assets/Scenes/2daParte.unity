--- !u!114 &1048120027
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1048120022}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dbc22598762463945aebb97aba4847d6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
  inventoryItemName: Nuevo Item
  dialogueLines:
  - speakerName: Lin
    dialogueText: "Ah, Lilith justo a tiempo. Estoy preparando algo para mi hijo,
      para regal\xE1rselo cuando nazca."
    leftSpeaker: 1
    characterSprite: {fileID: -4920136608581562092, guid: 3687bfad6f495db4d90baf3fbf03ad8e, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lin
    dialogueText: ' Seguro que a Amara le gusta este detalle'
    leftSpeaker: 1
    characterSprite: {fileID: -4920136608581562092, guid: 3687bfad6f495db4d90baf3fbf03ad8e, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lin
    dialogueText: "Quiero algo que simbolice nuestro cuidado y protecci\xF3n."
    leftSpeaker: 1
    characterSprite: {fileID: -4920136608581562092, guid: 3687bfad6f495db4d90baf3fbf03ad8e, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lin
    dialogueText: "Pero\u2026 estoy un poco ocupado. \xBFPodr\xEDas ayudarme a conseguir
      las piezas que necesito?"
    leftSpeaker: 1
    characterSprite: {fileID: -4920136608581562092, guid: 3687bfad6f495db4d90baf3fbf03ad8e, type: 3}
    endDialogueHere: 0
    choices:
    - choiceText: Claro, dime que es lo que necesitas
      nextDialogueIndex: 4
    - choiceText: "\xBFQu\xE9 tipo de regalo es? Yo te ayudo encantada"
      nextDialogueIndex: 4
    - choiceText: "Parece algo delicado\u2026 intentar\xE9 ayudarte"
      nextDialogueIndex: 4
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lin
    dialogueText: Gracias. Estaba pensando en una manta que tenga cosidas unas cuantas
      Safiras
    leftSpeaker: 1
    characterSprite: {fileID: -4920136608581562092, guid: 3687bfad6f495db4d90baf3fbf03ad8e, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lin
    dialogueText: "Por si no lo sabes, las safiras son gemas de la protecci\xF3n
      para que el beb\xE9 est\xE9 protegido."
    leftSpeaker: 1
    characterSprite: {fileID: -4920136608581562092, guid: 3687bfad6f495db4d90baf3fbf03ad8e, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lin
    dialogueText: 'Primero necesito estas cosas:'
    leftSpeaker: 1
    characterSprite: {fileID: -4920136608581562092, guid: 3687bfad6f495db4d90baf3fbf03ad8e, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lin
    dialogueText: "Hace un par de d\xEDas se me cay\xF3 una bolsa con Safiras al
      pozo\u2026 un despiste. \xBFPodr\xEDas recogerlas?"
    leftSpeaker: 1
    characterSprite: {fileID: -4920136608581562092, guid: 3687bfad6f495db4d90baf3fbf03ad8e, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lin
    dialogueText: "Y ya con lo de la tela, le mand\xE9 el encargo a Orren. \xBFPodr\xEDas
      pasar y ver si ya la tiene?"
    leftSpeaker: 1
    characterSprite: {fileID: -4920136608581562092, guid: 3687bfad6f495db4d90baf3fbf03ad8e, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: Claro, sin problema Lin, yo te ayudo
    leftSpeaker: 0
    characterSprite: {fileID: 6377917850455477399, guid: b3555c8a1e4ebba4e84c64c3e0c1ec36, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lin
    dialogueText: "Muchas gracias Lilith, te esperar\xE9 por esta zona"
    leftSpeaker: 1
    characterSprite: {fileID: -4920136608581562092, guid: 3687bfad6f495db4d90baf3fbf03ad8e, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
