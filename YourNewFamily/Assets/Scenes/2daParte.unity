  defaultRightSprite: {fileID: -1674950913012282259, guid: a5603edeb1e5a3d45a5e2ebd1a655387, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogueId: 74fe3dcb-e3db-4378-8680-1e7a598f12fe
  dialogues:
  - speakerName: Orren
    dialogueText: "Yo soy Orren. Me ocupo de que las herramientas y todo el material
      est\xE9n en orden. Si algo se rompe, viene a m\xED. Nada m\xE1s, nada menos."
    leftSpeaker: 1
    characterSprite: {fileID: -1303178727368756583, guid: 8f04080569460f8439677618d49b65a8, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Vaya, parece que tienes mucho control sobre lo que pasa aqu\xED."
    leftSpeaker: 0
    characterSprite: {fileID: 6377917850455477399, guid: 25e65e92d43918b438de921ced967a6a, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Orren
    dialogueText: "Control es relativo. Solo aseguro que las cosas funcionen. No
      m\xE1s misterios."
    leftSpeaker: 1
    characterSprite: {fileID: -1303178727368756583, guid: 8f04080569460f8439677618d49b65a8, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
