  m_Script: {fileID: 11500000, guid: 58c785d1312487d48bae41c65e986f1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterLeft: {fileID: 1580158365}
  characterRight: {fileID: 1968588241}
