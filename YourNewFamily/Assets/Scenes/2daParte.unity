--- !u!114 &1219237647
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1219237642}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dbc22598762463945aebb97aba4847d6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
  inventoryItemName: Nuevo Item
  dialogueLines:
  - speakerName: Lilith
    dialogueText: Cairen...?
    leftSpeaker: 0
    characterSprite: {fileID: -793861177819025959, guid: 23788c465c8b7f445a8c698898d0f7e4, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "\xBFSabes qu\xE9 me pidieron anoche? La peque\xF1a no pod\xEDa
      dormir. Dec\xEDa que cuando nos fu\xE9ramos quer\xEDa una casa con ventanas
      grandes."
    leftSpeaker: 1
    characterSprite: {fileID: 1671261912145405086, guid: 70916b0e3f5b8cf4cb61b278b381d566, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: " Yo les dije que s\xED. M\xEDralas. \xBFVes esos carteles? \xBFTraidora?
      \xBFInfiel? ...\xBFA qui\xE9n traicionaron? \xBFA qui\xE9n fueron infieles?
      Yo las traje aqu\xED."
    leftSpeaker: 1
    characterSprite: {fileID: 1671261912145405086, guid: 70916b0e3f5b8cf4cb61b278b381d566, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "Yo confi\xE9. Yo les dije que este lugar era seguro."
    leftSpeaker: 1
    characterSprite: {fileID: 1671261912145405086, guid: 70916b0e3f5b8cf4cb61b278b381d566, type: 3}
    endDialogueHere: 0
    choices:
    - choiceText: "No pod\xEDas saberlo."
      nextDialogueIndex: 4
    - choiceText: Esto no fue culpa tuya.
      nextDialogueIndex: 15
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: Soy su hermano mayor. Mi trabajo era saberlo.
    leftSpeaker: 1
    characterSprite: {fileID: 1671261912145405086, guid: 70916b0e3f5b8cf4cb61b278b381d566, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "Promet\xED que nadie las volver\xEDa a tocar. Y m\xEDralas. Yo
      iba a sacarlas de aqu\xED ma\xF1ana."
    leftSpeaker: 1
    characterSprite: {fileID: 1671261912145405086, guid: 70916b0e3f5b8cf4cb61b278b381d566, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: Confiaron en ti.
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: 2fd71506cd35b37499404742fc662a69, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "S\xED. Confiaron en m\xED..."
    leftSpeaker: 1
    characterSprite: {fileID: 1671261912145405086, guid: 70916b0e3f5b8cf4cb61b278b381d566, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "Fall\xE9. Dime que no fue culpa m\xEDa. D\xCDMELO LILITH. Haz
      el favor..."
    leftSpeaker: 1
    characterSprite: {fileID: 1671261912145405086, guid: 70916b0e3f5b8cf4cb61b278b381d566, type: 3}
    endDialogueHere: 0
    choices:
    - choiceText: Te lo mereces
      nextDialogueIndex: 9
    - choiceText: Te lo mereces
      nextDialogueIndex: 9
    - choiceText: Te lo mereces
      nextDialogueIndex: 9
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "Eso pensaba que dir\xEDa el mundo. Pero no t\xFA. Yo te defend\xED
      cuando otros dudaban. Yo dije que t\xFA no eras como ellos. Me equivoqu\xE9."
    leftSpeaker: 1
    characterSprite: {fileID: 1671261912145405086, guid: 70916b0e3f5b8cf4cb61b278b381d566, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "\xBFSabes qu\xE9 es lo peor? Que si pudiera volver atr\xE1s volver\xEDa
      a traerlas. Porque incluso esto era mejor que el lugar del que hu\xEDamos."
    leftSpeaker: 1
    characterSprite: {fileID: 1671261912145405086, guid: 70916b0e3f5b8cf4cb61b278b381d566, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "No te preocupes. No voy a fallarles otra vez. Esta vez s\xED me
      pondr\xE9 delante. Cuida de que alguien te quiera alg\xFAn d\xEDa, Lilith."
    leftSpeaker: 1
    characterSprite: {fileID: 1671261912145405086, guid: 70916b0e3f5b8cf4cb61b278b381d566, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "Porque cuando te quedes sola no vas a poder culpar a nadie. ...
      Adi\xF3s, Lilith."
    leftSpeaker: 1
    characterSprite: {fileID: 1923807302240037215, guid: 7fb157de43901c841a5c1e1630a2e948, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Adi\xF3s, Cairen"
    leftSpeaker: 0
    characterSprite: {fileID: 11193807160901837, guid: feaf89ab787e8224ea15f5b16245f391, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: ...
    leftSpeaker: 1
    characterSprite: {fileID: 1923807302240037215, guid: 7fb157de43901c841a5c1e1630a2e948, type: 3}
    endDialogueHere: 1
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "Cuando alguien jura proteger\u2026 y falla\u2026 eso tiene nombre.
      Se llama culpa."
    leftSpeaker: 1
    characterSprite: {fileID: 1671261912145405086, guid: 70916b0e3f5b8cf4cb61b278b381d566, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "Promet\xED que nadie las volver\xEDa a tocar. Y m\xEDralas. Yo
      iba a sacarlas de aqu\xED ma\xF1ana."
    leftSpeaker: 1
    characterSprite: {fileID: 1671261912145405086, guid: 70916b0e3f5b8cf4cb61b278b381d566, type: 3}
    endDialogueHere: 0
    choices: []
