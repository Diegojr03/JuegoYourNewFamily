  - speakerName: Lilith
    dialogueText: No... No... No... No...
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Yo... yo no deber\xEDa haberme ido..."
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Dije que volver\xEDa... lo dije..."
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Esto\u2026 esto no ten\xEDa que pasar\u2026 Yo os dej\xE9 aqu\xED\u2026
      Amara\u2026 tu hijo\u2026"
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Nira\u2026 No\u2026 no puedo\u2026 no puedo con esto\u2026 Por
      favor\u2026 que alguien me perdone\u2026"
    giveItemAfterThisLine: 0
