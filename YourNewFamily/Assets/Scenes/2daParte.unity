--- !u!114 &2107119275
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2107119273}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dbc22598762463945aebb97aba4847d6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueId: ac364e43-f637-495d-b5c3-14eed37be59d
  protagonistName: Lilith
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
  inventoryItemName: Nuevo Item
  dialogueLines:
  - speakerName: Lilith
    dialogueText: "\xBFAlpha\u2026? \xBFQu\xE9 est\xE1s haciendo aqu\xED?"
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: bab0a3cb2ddcbf74782f358147544b33, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Te estaba esperando, Lilith. La familia nunca duerme del todo
      y t\xFA eres alguien a quien conviene cuidar muy de cerca."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Tu \xE1rbol est\xE1 creciendo de forma maravillosa. Eres especial.
      Pero toda semilla necesita abono para florecer."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "\xBFAbono? \xBFQuieres decir que debo hacer algo?"
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: bab0a3cb2ddcbf74782f358147544b33, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Hay una plaga de bichos en el huerto de Jesal. \r\n"
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Est\xE1 corrompiendo lo que con tanto cari\xF1o cultivamos."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 0
    choices:
    - choiceText: "Si es una amenaza para la familia\u2026 har\xE9 lo que haga falta."
      nextDialogueIndex: 6
    - choiceText: "\xBFUna plaga? \xBFEstas seguro de que eso va a afectar?"
      nextDialogueIndex: 14
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Tu lealtad es un b\xE1lsamo para este lugar, Lilith. Entiendes
      lo que muchos tardan a\xF1os en comprender."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Esto purificar\xE1 la tierra, vi\xE9rtelo en las plantas. S\xE9
      que no es agradable. Pero lo necesario rara vez lo es."
    leftSpeaker: 1
    characterSprite: {fileID: 8379664347739615351, guid: 79502e6f2b7c2fc4db01211d2366d4c1, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Alpha\u2026 no estoy segura de esto."
    leftSpeaker: 0
    characterSprite: {fileID: -2470595747785517482, guid: 1e90cf757f218af4da389c6b1ba8380b, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Lilith m\xEDrame. Cuando llegaste, estabas rota. Perdida. Sin
      rumbo. Esta familia te est\xE1 dando un prop\xF3sito. Un sitio donde eres vista
      donde eres necesaria."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Si t\xFA no lo haces\u2026 \xBFQui\xE9n proteger\xE1 a los nuestros?
      Esto no es crueldad. Esto es amor. Amor hacia todos los que dependen de nosotros."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Conf\xEDo en ti, Lilith. No me decepciones. Hazlo por la familia."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: 
    dialogueText: "\u201DHas obtenido el vial\u201D"
    leftSpeaker: 0
    characterSprite: {fileID: -1674950913012282259, guid: a5603edeb1e5a3d45a5e2ebd1a655387, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Av\xEDsame cuando termines. Estar\xE9 aqu\xED\u2026 esper\xE1ndote
      en tu cuarto."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 1
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Estoy seguro de que s\xED, y si llega a expandirse pondr\xEDa
      en peligro a todos. Esta misi\xF3n es importante, Lilith\u2026 para la familia.
      No me falles ahora."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Esto purificar\xE1 la tierra, vi\xE9rtelo en las plantas. S\xE9
      que no es agradable. Pero lo necesario rara vez lo es."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Alpha\u2026 no estoy segura de esto."
    leftSpeaker: 0
    characterSprite: {fileID: -2470595747785517482, guid: 1e90cf757f218af4da389c6b1ba8380b, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Lilith m\xEDrame. Cuando llegaste, estabas rota. Perdida. Sin
      rumbo. Esta familia te est\xE1 dando un prop\xF3sito. Un sitio donde eres vista
      donde eres necesaria."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Si t\xFA no lo haces\u2026 \xBFQui\xE9n proteger\xE1 a los nuestros?
      Esto no es crueldad. Esto es amor. Amor hacia todos los que dependen de nosotros."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Conf\xEDo en ti, Lilith. No me decepciones. Hazlo por la familia."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: 
    dialogueText: "\u201DHas obtenido el vial\u201D"
    leftSpeaker: 0
    characterSprite: {fileID: -1674950913012282259, guid: a5603edeb1e5a3d45a5e2ebd1a655387, type: 3}
    endDialogueHere: 0
