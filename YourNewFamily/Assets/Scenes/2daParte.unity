  spriteRight: {fileID: 1935380051}
  defaultLeftSprite: {fileID: 8379664347739615351, guid: 79502e6f2b7c2fc4db01211d2366d4c1, type: 3}
  defaultRightSprite: {fileID: -1674950913012282259, guid: a5603edeb1e5a3d45a5e2ebd1a655387, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogueId: 67ed35c6-0f38-4c22-b908-13644b1ff623
  dialogues:
  - speakerName: Alpha
    dialogueText: "La profec\xEDa habla de un \xFAltimo sacrificio. Uno que abra
      definitivamente el camino."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Todos vosotros hab\xE9is bebido del \xC1rbol. Hab\xE9is servido
      a la Familia. Y ahora vais a completar su voluntad.\r"
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Senna
    dialogueText: "Alpha nos ense\xF1\xF3 el camino.\r"
    leftSpeaker: 1
    characterSprite: {fileID: 3856346601617344948, guid: 9f33454e1b9ebfe43bcf08ba7701d1cc, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Saira
    dialogueText: "La Familia es lo \xFAnico real."
    leftSpeaker: 1
    characterSprite: {fileID: -3831238259454085789, guid: 9b358b9ade0e9384b8a0700a85d0835e, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Orren
    dialogueText: "El n\xE9ctar nos libera."
    leftSpeaker: 1
    characterSprite: {fileID: -4787064390791451594, guid: 5ce544bcff0717e4e9d963ae7967d1bf, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Nami
    dialogueText: "Por la Familia\u2026 hasta el final."
    leftSpeaker: 1
    characterSprite: {fileID: 5534955435649285105, guid: 2a52eb0a4cf7e8448aa49c06e2a9089c, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Anorah
    dialogueText: Alpha ve lo que nosotros no podemos ver.
    leftSpeaker: 1
    characterSprite: {fileID: -1024897035168937694, guid: da66bb96cc9b81840a35c31db4c76318, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Silas
    dialogueText: Hoy renacemos. ...
    leftSpeaker: 1
    characterSprite: {fileID: -2761318374343072399, guid: 2951976c8ce54f84e8110aa3b3551223, type: 3}
    giveItemAfterThisLine: 0
