--- !u!114 &1468540961
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1468540959}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58c785d1312487d48bae41c65e986f1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterLeft: {fileID: 1742376853}
  characterRight: {fileID: 1711420086}
  spriteLeft: {fileID: 1742376854}
  spriteRight: {fileID: 1711420087}
  defaultLeftSprite: {fileID: 5142150385823802636, guid: 8021cc465af10bb4599980e12b377f51, type: 3}
  defaultRightSprite: {fileID: -334247398747001510, guid: 0f06b139cbeb33c4bbe16830d21d0c38, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogues:
  - speakerName: Nami
    dialogueText: "\xA1Eh! \xA1Eh! Si crees que esto es bailar, tienes que ver a
      Cairen. Es el rey de la pista."
    leftSpeaker: 1
    characterSprite: {fileID: -3576949346207451548, guid: 94809297caacd1e439dc8566c99cb3c1, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Nami
    dialogueText: " No s\xE9 d\xF3nde aprendi\xF3 esos pasos, pero son lo mejor de
      la noche. \xA1Ve a buscarlo!"
    leftSpeaker: 1
    characterSprite: {fileID: -3576949346207451548, guid: 94809297caacd1e439dc8566c99cb3c1, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Pues ahora que lo dices, \xBFdonde se habr\xE1 metido Cairen?"
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: 2fd71506cd35b37499404742fc662a69, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Nami
    dialogueText: "\xA1Hace un momento estaba aqu\xED! Pero lo vi irse hacia arriba\u2026
      hacia el norte. A ver si lo encuentras antes que yo."
    leftSpeaker: 1
    characterSprite: {fileID: -3576949346207451548, guid: 94809297caacd1e439dc8566c99cb3c1, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Nami
    dialogueText: "Tengo ganas de retarle a un baile. Y esta vez pienso ganarle.
      \xA1Si lo ves, dile que no se esconda!"
    leftSpeaker: 1
    characterSprite: {fileID: -3576949346207451548, guid: 94809297caacd1e439dc8566c99cb3c1, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
  inventoryItemName: Nuevo Item
