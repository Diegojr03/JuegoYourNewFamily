--- !u!114 &483295549
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 483295547}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58c785d1312487d48bae41c65e986f1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterLeft: {fileID: 25065046}
  characterRight: {fileID: 1278843370}
  spriteLeft: {fileID: 25065047}
  spriteRight: {fileID: 1278843371}
  defaultLeftSprite: {fileID: -6251996199138996978, guid: 11b2ec938a1c09442aa1622f4decd3bd, type: 3}
  defaultRightSprite: {fileID: -1674950913012282259, guid: a5603edeb1e5a3d45a5e2ebd1a655387, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogueId: f791c50b-640b-406c-b8b7-6db91cf16a72
  dialogues:
  - speakerName: Jesal
    dialogueText: "\xA1Lillith! Justo pensaba en ti. \xBFVes? Las semillas de Hesp\xE9rides
      ya est\xE1n brotando. Es un milagro cotidiano."
    leftSpeaker: 1
    characterSprite: {fileID: 3248528778425116306, guid: 47fec4e6f7cf1ea44906f7454bdaeb7f, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Jesal
    dialogueText: "Mira a este peque\xF1o. Es la alegr\xEDa de Amara. Lo cuido yo
      mientras ella descansa. \r\r\n"
    leftSpeaker: 1
    characterSprite: {fileID: 3248528778425116306, guid: 47fec4e6f7cf1ea44906f7454bdaeb7f, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Jesal
    dialogueText: "Dice que el beb\xE9 patea de emoci\xF3n cada vez que Nube salta
      cerca de su vientre"
    leftSpeaker: 1
    characterSprite: {fileID: 3248528778425116306, guid: 3df77a36a51982142a2dbb961e92eadf, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Jesal
    dialogueText: "Es... un v\xEDnculo tan puro, \xBFno crees? Como un presagio de
      la nueva vida que viene."
    leftSpeaker: 1
    characterSprite: {fileID: 3248528778425116306, guid: 3df77a36a51982142a2dbb961e92eadf, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Jesal
    dialogueText: "\xBFVerdad que es precioso? A veces pienso que los animales son
      los \xFAnicos que no juzgan, que solo dan amor. "
    leftSpeaker: 1
    characterSprite: {fileID: 3248528778425116306, guid: 3df77a36a51982142a2dbb961e92eadf, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Jesal
    dialogueText: "\xC9l ni siquiera se come las Hesp\xE9rides, solo las malas hierbas. 
      Es un alma inocente."
    leftSpeaker: 1
    characterSprite: {fileID: 3248528778425116306, guid: 3df77a36a51982142a2dbb961e92eadf, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Jesal
    dialogueText: "Me alegra que est\xE9s aqu\xED, Lillith. Al principio, Jase me
      dijo que desconfiara... pero yo siento que t\xFA tambi\xE9n buscas esa pureza,
      esa conexi\xF3n verdadera con nosotros."
    leftSpeaker: 1
    characterSprite: {fileID: 3248528778425116306, guid: 3df77a36a51982142a2dbb961e92eadf, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Jesal
    dialogueText: "Este lugar nos est\xE1 sanando a todos, a nuestra manera. Hasta
      a los m\xE1s... da\xF1ados."
    leftSpeaker: 1
    characterSprite: {fileID: 3248528778425116306, guid: 3df77a36a51982142a2dbb961e92eadf, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Oye, he visto a Cairen busc\xE1ndote. Parec\xEDa tener prisa."
    leftSpeaker: 0
    characterSprite: {fileID: 6377917850455477399, guid: 25e65e92d43918b438de921ced967a6a, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Jesal
    dialogueText: "Mi hermano... Seguro que es algo del cerco. Luego le ver\xE9.
      Primero debo ir a preparar el t\xE9 de Elara."
    leftSpeaker: 1
    characterSprite: {fileID: 3248528778425116306, guid: 3df77a36a51982142a2dbb961e92eadf, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Jesal
    dialogueText: "Cuida de Nube por m\xED, \xBFvale? S\xE9 que estar\xE1 seguro
      contigo."
    leftSpeaker: 1
    characterSprite: {fileID: -325410527933720274, guid: 24dbb70e582dffd48822c8c6bfb8a87a, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
