--- !u!114 &1297689920
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1297689915}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58c785d1312487d48bae41c65e986f1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterLeft: {fileID: 902438069}
  characterRight: {fileID: 1568494388}
  spriteLeft: {fileID: 902438070}
  spriteRight: {fileID: 1568494389}
  defaultLeftSprite: {fileID: 4301479014330281642, guid: c4237e9ccc4d35346865cbf603a993bc, type: 3}
  defaultRightSprite: {fileID: -1674950913012282259, guid: a5603edeb1e5a3d45a5e2ebd1a655387, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogueId: df3b243c-4642-4a26-8acd-9702cfd482ad
  dialogues:
  - speakerName: Nira
    dialogueText: "No\u2026 no puede ser\u2026 \xBFd\xF3nde est\xE1s? \xA1\xBFD\xF3nde
      est\xE1s?!"
    leftSpeaker: 1
    characterSprite: {fileID: -7441966514919091945, guid: 9f9fe1a63c320df4db63aba074738e18, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Nira\u2026 \xBFest\xE1s bien?"
    leftSpeaker: 0
    characterSprite: {fileID: -793861177819025959, guid: a0d3b193b6e13604f814ddfdaef6455f, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Nira
    dialogueText: "No. No estoy bien. Cael me pidi\xF3 hierba lunar para preparar
      los ung\xFCentos de esta tarde y no la encuentro."
    leftSpeaker: 1
    characterSprite: {fileID: -7441966514919091945, guid: 9f9fe1a63c320df4db63aba074738e18, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "\xBFSe ha perdido?"
    leftSpeaker: 0
    characterSprite: {fileID: -7255883190028503133, guid: c71e25c1c6d3b974485111da8be9c7bd, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Nira
    dialogueText: "No lo s\xE9. Tal vez alguien la tom\xF3 sin avisarme. Tal vez
      la movieron."
    leftSpeaker: 1
    characterSprite: {fileID: -7441966514919091945, guid: 9f9fe1a63c320df4db63aba074738e18, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Nira
    dialogueText: "O\u2026 tal vez la mezcl\xE9 con otras. Es que todas se parecen
      cuando se secan y\u2026 ahora no s\xE9 qu\xE9 es qu\xE9."
    leftSpeaker: 1
    characterSprite: {fileID: -7441966514919091945, guid: 9f9fe1a63c320df4db63aba074738e18, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "\xBFQuieres que te ayude a buscarla?"
    leftSpeaker: 0
    characterSprite: {fileID: 6377917850455477399, guid: 25e65e92d43918b438de921ced967a6a, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Nira
    dialogueText: "S\xED\u2026 por favor. No quiero decepcionarlos otra vez. Tiene
      como una textura sedosa y las hojas curvadas.\n"
    leftSpeaker: 1
    characterSprite: {fileID: -7441966514919091945, guid: 9f9fe1a63c320df4db63aba074738e18, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
