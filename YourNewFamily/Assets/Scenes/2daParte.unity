--- !u!114 &1492939559
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1492939553}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58c785d1312487d48bae41c65e986f1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterLeft: {fileID: 489547854}
  characterRight: {fileID: 63403369}
  spriteLeft: {fileID: 489547855}
  spriteRight: {fileID: 63403370}
  defaultLeftSprite: {fileID: 8379664347739615351, guid: 79502e6f2b7c2fc4db01211d2366d4c1, type: 3}
  defaultRightSprite: {fileID: -1674950913012282259, guid: a5603edeb1e5a3d45a5e2ebd1a655387, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogueId: 42b780cc-373d-4f45-b805-048b4b5e24c0
  dialogues:
  - speakerName: Alpha
    dialogueText: Lilith... Tu presencia habla por ti. Ya no hace falta que digas
      nada. Lo has cumplido.
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "El huerto respira otra vez. La esencia vuelve a fluir. Has hecho
      lo que deb\xEDa hacerse. "
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Un acto peque\xF1o pero de enorme consecuencia para todos. S\xE9
      que no ha sido f\xE1cil. S\xE9 que tu coraz\xF3n a\xFAn tiembla"
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Pero escucha: la duda no es un pecado. La desobediencia s\xED.
      Y t\xFA elegiste a la familia. Eso es lo que importa."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Yo\u2026 no estoy segura de que\u2026de que haya sido lo correcto."
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: bab0a3cb2ddcbf74782f358147544b33, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Lo correcto, Lilith\u2026 nunca se siente bien al principio. El
      deber raras veces es placentero. "
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Pero te lo prometo: cuando veas c\xF3mo prospera este lugar, cuando
      veas c\xF3mo florece todo gracias a tus manos entender\xE1s todo."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Tu \xE1rbol crecer\xE1 fuerte. M\xE1s fuerte que todos los dem\xE1s"
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Has dado un paso hacia la verdadera pureza. Ahora\u2026 la familia
      te espera."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Re\xFAnete con los dem\xE1s en el comedor."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "S\xED\u2026 Alpha."
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: bab0a3cb2ddcbf74782f358147544b33, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
