--- !u!114 &423249628
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 423249624}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58c785d1312487d48bae41c65e986f1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterLeft: {fileID: 656313668}
  characterRight: {fileID: 824580563}
  spriteLeft: {fileID: 656313667}
  spriteRight: {fileID: 824580562}
  defaultLeftSprite: {fileID: 657193517335828509, guid: 114d4a2f78d4b8948925c89d60d049c2, type: 3}
  defaultRightSprite: {fileID: 11193807160901837, guid: feaf89ab787e8224ea15f5b16245f391, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogues:
  - speakerName: Alpha
    dialogueText: "Lillith c\xE1lmate. S\xE9 que duele. S\xE9 lo que has visto pero
      gritar y llorar sola no traer\xE1 nada de vuelta."
    leftSpeaker: 1
    characterSprite: {fileID: -8106269189103352243, guid: bd14f137295602c4d99506bc42db21b9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "\xA1No\u2026 no puedo\u2026 yo\u2026 yo deb\xEDa protegerlas!"
    leftSpeaker: 0
    characterSprite: {fileID: 0}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Lo s\xE9\u2026 lo s\xE9, tu coraz\xF3n es puro. Siempre has querido
      cuidar de los dem\xE1s. Esa es la raz\xF3n por la que te conf\xEDo estas tareas."
    leftSpeaker: 1
    characterSprite: {fileID: -8106269189103352243, guid: bd14f137295602c4d99506bc42db21b9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: Pero hay momentos en los que incluso los mejores de nosotros no
      podemos cambiar lo que ha sucedido.
    leftSpeaker: 1
    characterSprite: {fileID: -8106269189103352243, guid: bd14f137295602c4d99506bc42db21b9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Yo\u2026 yo las dej\xE9\u2026 no deb\xED\u2026"
    leftSpeaker: 0
    characterSprite: {fileID: 0}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: La culpa no te pertenece por completo, Lillith. Has hecho lo que
      estaba a tu alcance.
    leftSpeaker: 1
    characterSprite: {fileID: -8106269189103352243, guid: bd14f137295602c4d99506bc42db21b9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Nadie sabr\xE1 la verdad de lo que ocurri\xF3, y Delta se encargar\xE1
      de cubrirlo. Nadie te juzgar\xE1."
    leftSpeaker: 1
    characterSprite: {fileID: -8106269189103352243, guid: bd14f137295602c4d99506bc42db21b9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Ahora necesitas recuperar tu fuerza, tu claridad aunque tu coraz\xF3n
      est\xE9 herido."
    leftSpeaker: 1
    characterSprite: {fileID: -8106269189103352243, guid: bd14f137295602c4d99506bc42db21b9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "\xBFDe verdad\u2026 nadie lo sabr\xE1?"
    leftSpeaker: 0
    characterSprite: {fileID: 0}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "S\xED. Conf\xEDa en m\xED. Ven, tranquil\xEDzate. Respira. Deja
      que el mundo se calme alrededor de ti un instante."
    leftSpeaker: 1
    characterSprite: {fileID: -8106269189103352243, guid: bd14f137295602c4d99506bc42db21b9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: Recuerda, esta familia, todos nosotros nos sostenemos entre nosotros.
    leftSpeaker: 1
    characterSprite: {fileID: -8106269189103352243, guid: bd14f137295602c4d99506bc42db21b9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Nadie queda atr\xE1s, ni siquiera cuando parece que todo se ha
      perdido."
    leftSpeaker: 1
    characterSprite: {fileID: -8106269189103352243, guid: bd14f137295602c4d99506bc42db21b9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Conf\xEDa en m\xED, Lillith. Conf\xEDa en la familia. Te devolver\xE9
      tu fuerza."
    leftSpeaker: 1
    characterSprite: {fileID: -8106269189103352243, guid: bd14f137295602c4d99506bc42db21b9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Toma esto. Te ayudar\xE1 a calmar tu mente, a que tu coraz\xF3n
      deje de desgarrarse por un momento."
    leftSpeaker: 1
    characterSprite: {fileID: -8106269189103352243, guid: bd14f137295602c4d99506bc42db21b9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "D\xE9jate sostener, Lillith. La familia siempre te levantar\xE1."
    leftSpeaker: 1
    characterSprite: {fileID: -8106269189103352243, guid: bd14f137295602c4d99506bc42db21b9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: 
    dialogueText: "*Bebes el n\xE9ctar de la botella que te da Alpha*"
    leftSpeaker: 0
    characterSprite: {fileID: -6751318744405601006, guid: 377001099d54d0f478295771fe716d43, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Lillith, ahora debes alimentar el \xE1rbol con las esencias que
      te han confiado."
    leftSpeaker: 1
    characterSprite: {fileID: -8106269189103352243, guid: bd14f137295602c4d99506bc42db21b9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "S-s\xED\u2026 lo har\xE9\u2026 todo lo que me digas\u2026"
    leftSpeaker: 0
    characterSprite: {fileID: 0}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Coge el peluche de Amara, su amor y cuidado est\xE1n ligados a
      ella. No te olvides del lazo de Nira. Su ternura y paciencia\u2026"
    leftSpeaker: 1
    characterSprite: {fileID: -8106269189103352243, guid: bd14f137295602c4d99506bc42db21b9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "S-s\xED\u2026 ir\xE9\u2026 tal como dices\u2026"
    leftSpeaker: 0
    characterSprite: {fileID: 0}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
  inventoryItemName: Nuevo Item
