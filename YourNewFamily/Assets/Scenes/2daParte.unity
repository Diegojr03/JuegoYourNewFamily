--- !u!114 &945661502
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 945661497}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dbc22598762463945aebb97aba4847d6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
  inventoryItemName: Nuevo Item
  dialogueLines:
  - speakerName: Cairen
    dialogueText: "\xDAltimamente la gente est\xE1 rara. M\xE1s que antes. Se distraen.
      Se callan a mitad de frase. Sonr\xEDen cuando no toca. "
    leftSpeaker: 1
    characterSprite: {fileID: 6775278750140180628, guid: 4996e8616930a4947817a517bd018a82, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: " Y luego pasan cosas\u2026 y nadie parece sorprendido. Jesal conf\xEDa
      en todo el mundo. Jase dice que no, pero tambi\xE9n."
    leftSpeaker: 1
    characterSprite: {fileID: 6775278750140180628, guid: 4996e8616930a4947817a517bd018a82, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: Y yo no siempre puedo estar con ellas. Necesito saber si puedo
      confiar en ti para una cosa. No es una tarea. Tiene que ver con sus vidas.
    leftSpeaker: 1
    characterSprite: {fileID: 6775278750140180628, guid: 4996e8616930a4947817a517bd018a82, type: 3}
    endDialogueHere: 0
    choices:
    - choiceText: "Si hay peligro, d\xEDmelo. No voy a mirar a otro lado."
      nextDialogueIndex: 3
    - choiceText: "No lo entiendo todo de este lugar\u2026 pero a ellas no las tocar\xE1
        nadie mientras yo est\xE9 aqu\xED."
      nextDialogueIndex: 3
    - choiceText: "\xBFT\xFA crees que ellas querr\xEDan que las ayudase? Aunque
        eres parte de la familia, te ayudar\xEDa igualmente"
      nextDialogueIndex: 3
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "Eso es lo que necesitaba o\xEDr. Gracias, Lilith. Acomp\xE1\xF1ame
      otra vez, volvamos con mis hermanas."
    leftSpeaker: 1
    characterSprite: {fileID: 6775278750140180628, guid: 4996e8616930a4947817a517bd018a82, type: 3}
    endDialogueHere: 1
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
