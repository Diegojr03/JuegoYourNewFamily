  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f69405e443069f544b51770be0c0f5f6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueId: f12ff17c-6faa-4943-b346-883eadd40600
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
  inventoryItemName: Nuevo Item
  textSpeed: 0.05
  autoActivate: 1
  guardarEnBacklog: 0
  dialogueSections:
  - speakerName: Nota
    dialogueText: "Lilith,\r\nLa \xFAltima parte de la profec\xEDa debe cumplirse
      en el lugar donde todo comenz\xF3.\r"
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Nota
    dialogueText: "En la cima de la monta\xF1a.\r\nEl \xC1rbol se ha expandido.\r"
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Nota
    dialogueText: "Ahora est\xE1 a la espera.\r\nYo ir\xE9 preparando el ritual.\r\r"
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Nota
    dialogueText: "No tardes.\r\nUna familia no debe hacerse esperar.\r\r\r"
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Bueno, no tengo m\xE1s remedio que ir.\r\r\r"
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
