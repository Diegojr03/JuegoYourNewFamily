--- !u!114 &1881443471
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1881443469}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58c785d1312487d48bae41c65e986f1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterLeft: {fileID: 49897606}
  characterRight: {fileID: 339701574}
  spriteLeft: {fileID: 49897607}
  spriteRight: {fileID: 339701575}
  defaultLeftSprite: {fileID: 8379664347739615351, guid: 79502e6f2b7c2fc4db01211d2366d4c1, type: 3}
  defaultRightSprite: {fileID: 4667012302030717492, guid: 53829adc40198dc4781d15288169ee6a, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogueId: 0bfecc92-dc83-40a1-90f5-46321fb19d5c
  dialogues:
  - speakerName: Alpha
    dialogueText: "Veo que lo encontraste.\r"
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "S\xED, estaba justo donde dijiste.\r"
    leftSpeaker: 0
    characterSprite: {fileID: -1121051369868863206, guid: 0a17a5f454453e1409307adaaaebc6e2, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Perfecto. Este texto es m\xE1s antiguo que esta casa. M\xE1s antiguo
      que esta comunidad. Aqu\xED est\xE1. La siguiente parte de la profec\xEDa."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "\xBFY qu\xE9 dice?\r"
    leftSpeaker: 0
    characterSprite: {fileID: -1121051369868863206, guid: 0a17a5f454453e1409307adaaaebc6e2, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Que el elegido debe demostrar su voluntad. Que antes del final\u2026
      debe aprender a dar el paso sin dudar.\r"
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Por eso esto tambi\xE9n forma parte de tu entrenamiento. Este
      arma es un instrumento de fe. Con \xE9l se completar\xE1 la profec\xEDa. Ahora
      te toca a ti.\r"
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: 
    dialogueText: '*Intentas descifrar el texto del cuchillo*'
    leftSpeaker: 0
    characterSprite: {fileID: -1121051369868863206, guid: 0a17a5f454453e1409307adaaaebc6e2, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "\xBFY qu\xE9 se supone que tengo que hacer con esto?\r"
    leftSpeaker: 0
    characterSprite: {fileID: -6974867021855848915, guid: 1e5f94e1a36cf434e84059be518bdf15, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Una peque\xF1a prueba. Nada que no puedas manejar.\r"
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Si consigues pasar esta prueba, sabr\xE1s la verdad de todo esto.
      Me acompa\xF1aras hasta el final y juntos\u2026 Nos alzaremos.\r"
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
  inventoryItemName: Nuevo Item
  objectsToActivateAfter:
  - {fileID: 64202080}
  objectsToDestroyAfter: []
  destroyAfterDialogue: 1
  autoActivate: 1
  reuseDelay: 0.5
