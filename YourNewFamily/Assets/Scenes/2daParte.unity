    dialogueText: "De verdad, significas m\xE1s para m\xED de lo que crees. Gracias
      por ayudarme."
    leftSpeaker: 1
    characterSprite: {fileID: -2145651702438150279, guid: 627580a089281b14288222df3486b075, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
