  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogueId: 6c186274-6f6a-4941-842a-3aa7c2235e98
  dialogues:
  - speakerName: Saira
    dialogueText: "Yo soy Saira. Mi trabajo es vigilar los hilos, asegur\xE1ndome
      de que los lazos entre todos est\xE9n intactos. Es un poco abstracto, pero
      importante."
    leftSpeaker: 1
    characterSprite: {fileID: -7386572047975426078, guid: 1dc99afa3d0bbd845b367f234db24ff4, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: Los hilos, te refieres a relaciones entre las personas?
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: bab0a3cb2ddcbf74782f358147544b33, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Saira
    dialogueText: "No exactamente. No son visibles, pero est\xE1n ah\xED. Vigilar
      que no se rompan evita problemas mayores."
    leftSpeaker: 1
    characterSprite: {fileID: -7386572047975426078, guid: 1dc99afa3d0bbd845b367f234db24ff4, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
