--- !u!114 &1139429294
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1139429290}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dbc22598762463945aebb97aba4847d6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueId: 12083823-66d9-4516-8746-d9298cd6450c
  protagonistName: Lilith
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
  inventoryItemName: Nuevo Item
  dialogueLines:
  - speakerName: Mary
    dialogueText: "Anda Lilith, \xBFqu\xE9 tal te va por aqu\xED? \u2026 ya sabes,
      me encargo de que todo siga su curso."
    leftSpeaker: 1
    characterSprite: {fileID: 5465866427460756199, guid: 0847a9c8166a9a34da3b89f71a02c6a9, type: 3}
    endDialogueHere: 0
    choices:
    - choiceText: "Me estoy adaptando poco a poco. Todo sigue siendo\u2026 distinto."
      nextDialogueIndex: 1
    - choiceText: "A\xFAn hay cosas que me cuesta asimilar."
      nextDialogueIndex: 2
    - choiceText: "Supongo que siempre hay algo que vigilar, \xBFno?"
      nextDialogueIndex: 3
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Mary
    dialogueText: "Es normal. Cada d\xEDa tiene su rutina, aunque a veces cambie
      la forma de mirarla."
    leftSpeaker: 1
    characterSprite: {fileID: -6479465113054775527, guid: 02081092b9bc2984294e5904ebb10ad9, type: 3}
    endDialogueHere: 1
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Mary
    dialogueText: "Nos pasa a todos. Lo raro no desaparece\u2026 solo deja de doler."
    leftSpeaker: 1
    characterSprite: {fileID: 5465866427460756199, guid: 0847a9c8166a9a34da3b89f71a02c6a9, type: 3}
    endDialogueHere: 1
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Mary
    dialogueText: "Siempre. Y cuando no lo hay, es cuando m\xE1s atenci\xF3n conviene
      prestar.\n"
    leftSpeaker: 1
    characterSprite: {fileID: 5465866427460756199, guid: 0847a9c8166a9a34da3b89f71a02c6a9, type: 3}
    endDialogueHere: 1
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
