  m_Name: 
  m_EditorClassIdentifier: 
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
  inventoryItemName: Nuevo Item
  dialogueLines:
  - speakerName: Delta
    dialogueText: "Buenos d\xEDas Lilith, dime\u2026 \xBFhas visto a Gamma por aqu\xED?"
    leftSpeaker: 1
    characterSprite: {fileID: -311131714167770203, guid: 93af13f8c3e47754583584387ce06a27, type: 3}
    endDialogueHere: 0
    choices:
    - choiceText: "No, no la he visto hoy\u2026 \xBFpor qu\xE9?"
      nextDialogueIndex: 1
    - choiceText: "\xBFEst\xE1 pasando algo con ella?"
      nextDialogueIndex: 1
    - choiceText: "No\u2026 \xBFdeber\xEDa preocuparme?"
      nextDialogueIndex: 1
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Delta
    dialogueText: "Si la ves d\xEDmelo, necesito hablar con ella"
    leftSpeaker: 1
    characterSprite: {fileID: -311131714167770203, guid: 93af13f8c3e47754583584387ce06a27, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "\xBFVale\u2026?"
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: 2fd71506cd35b37499404742fc662a69, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Delta
    dialogueText: "Por cierto, p\xE1sate por la zona de caba\xF1as, me preguntaron
      por ti."
    leftSpeaker: 1
    characterSprite: {fileID: -311131714167770203, guid: 93af13f8c3e47754583584387ce06a27, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
