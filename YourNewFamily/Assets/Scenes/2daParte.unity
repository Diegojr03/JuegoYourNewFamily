--- !u!114 &1272810746
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1272810744}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58c785d1312487d48bae41c65e986f1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterLeft: {fileID: 651177962}
  characterRight: {fileID: 852123575}
  spriteLeft: {fileID: 651177963}
  spriteRight: {fileID: 852123576}
  defaultLeftSprite: {fileID: -3267486010593951143, guid: 59b507b2052fe594f9783610c9224789, type: 3}
  defaultRightSprite: {fileID: -1674950913012282259, guid: a5603edeb1e5a3d45a5e2ebd1a655387, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogueId: 7b63f6b0-d70c-449f-8a5a-59ad7ad46320
  dialogues:
  - speakerName: Cairen
    dialogueText: "Cuando \xE9ramos peque\xF1os\u2026 Yo os promet\xED que nada malo
      os iba a pasar."
    leftSpeaker: 1
    characterSprite: {fileID: 6775278750140180628, guid: 823f378d910b52d4ebc4f90954058405, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "No sab\xEDa lo que dec\xEDa. Pero desde entonces\u2026 todo lo
      que hago es intentar que esa mentira no me desborde."
    leftSpeaker: 1
    characterSprite: {fileID: 6775278750140180628, guid: 823f378d910b52d4ebc4f90954058405, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Jesal
    dialogueText: Siempre dices eso como si fuera tu culpa.
    leftSpeaker: 1
    characterSprite: {fileID: -3324411832459599324, guid: c49fa99a3d66c674a9e747b5a250c5bd, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "Porque lo es. Aqu\xED dicen que este sitio cuida de la gente rota."
    leftSpeaker: 1
    characterSprite: {fileID: 6775278750140180628, guid: 823f378d910b52d4ebc4f90954058405, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Jase
    dialogueText: No estamos rotas.
    leftSpeaker: 1
    characterSprite: {fileID: 3561576131811353733, guid: 645cb11806640d44080d94bd679cc9f0, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "No. Ma\xF1ana nos vamos."
    leftSpeaker: 1
    characterSprite: {fileID: 6775278750140180628, guid: 823f378d910b52d4ebc4f90954058405, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: Bueno tampoco hace falta eso Cairen...
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: bab0a3cb2ddcbf74782f358147544b33, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Jesal
    dialogueText: "Lilith tiene raz\xF3n, \xBFest\xE1s seguro?"
    leftSpeaker: 1
    characterSprite: {fileID: -3324411832459599324, guid: c49fa99a3d66c674a9e747b5a250c5bd, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: Lo estoy chicas.
    leftSpeaker: 1
    characterSprite: {fileID: 6775278750140180628, guid: 823f378d910b52d4ebc4f90954058405, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Jesal
    dialogueText: "Pero Cairen tu amas este sitio, \xBFseguro que estar\xE1s bien?"
    leftSpeaker: 1
    characterSprite: {fileID: -3324411832459599324, guid: c49fa99a3d66c674a9e747b5a250c5bd, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: Eso no importa
    leftSpeaker: 1
    characterSprite: {fileID: 6775278750140180628, guid: 823f378d910b52d4ebc4f90954058405, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Jase
    dialogueText: "S\xED, s\xED que importa."
    leftSpeaker: 1
    characterSprite: {fileID: 3561576131811353733, guid: 645cb11806640d44080d94bd679cc9f0, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Cairen, de verdad, pi\xE9nsalo bien."
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: bab0a3cb2ddcbf74782f358147544b33, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "Estar\xE9 bien si vosotras est\xE1is bien. Eso es todo lo que
      necesito. Lilith, estoy seguro que t\xFA entiendes lo que es no encajar aqu\xED."
    leftSpeaker: 1
    characterSprite: {fileID: 6775278750140180628, guid: 823f378d910b52d4ebc4f90954058405, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "Lo veo en c\xF3mo miras alrededor, como si siempre estuvieras
      pidiendo permiso para respirar. Si quieres puedes venir con nosotros. Empezaremos
      de cero."
    leftSpeaker: 1
    characterSprite: {fileID: 6775278750140180628, guid: 823f378d910b52d4ebc4f90954058405, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Jesal
    dialogueText: "Podr\xEDamos aprender a hacer pan de verdad. No el de aqu\xED."
    leftSpeaker: 1
    characterSprite: {fileID: -3324411832459599324, guid: c49fa99a3d66c674a9e747b5a250c5bd, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Jase
    dialogueText: Y dormir sin que alguien te observe.
    leftSpeaker: 1
    characterSprite: {fileID: 3561576131811353733, guid: 645cb11806640d44080d94bd679cc9f0, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "Empezar\xE9 a trabajar. Estoy decidido. Mientras teng\xE1is una
      vida mejor que todo esto."
    leftSpeaker: 1
    characterSprite: {fileID: -7517056936566813833, guid: d85c8973fa3cab64e8410b1c1f9e03e4, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "Piensatelo Lilith. Ma\xF1ana, al amanecer, estaremos en la entrada."
    leftSpeaker: 1
    characterSprite: {fileID: -7517056936566813833, guid: d85c8973fa3cab64e8410b1c1f9e03e4, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Lo pensar\xE9."
    leftSpeaker: 0
    characterSprite: {fileID: 6377917850455477399, guid: 25e65e92d43918b438de921ced967a6a, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
  inventoryItemName: Nuevo Item
  objectsToActivateAfter:
  - {fileID: 242611925}
  - {fileID: 955843768}
  - {fileID: 1166834220}
