--- !u!114 &1206714675
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1206714673}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58c785d1312487d48bae41c65e986f1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterLeft: {fileID: 1594378529}
  characterRight: {fileID: 752694445}
  spriteLeft: {fileID: 1594378530}
  spriteRight: {fileID: 752694446}
  defaultLeftSprite: {fileID: 8379664347739615351, guid: 79502e6f2b7c2fc4db01211d2366d4c1, type: 3}
  defaultRightSprite: {fileID: -1674950913012282259, guid: a5603edeb1e5a3d45a5e2ebd1a655387, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogueId: 71353c79-74a6-412b-9a5d-a8e2ee64804f
  dialogues:
  - speakerName: Alpha
    dialogueText: "M\xEDrala. El \xFAltimo obst\xE1culo."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Gamma
    dialogueText: "Lilith\u2026 Dijiste que me ayudar\xEDas. Me dijiste que ibas
      a sacarme de ah\xED. Te cre\xED. No\u2026 No hagas esto."
    leftSpeaker: 1
    characterSprite: {fileID: -4831706047985285938, guid: 06e3e07abd727584c8ebc7318360d8b6, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "La profec\xEDa es clara. La sangre del traidor debe alimentar
      el \xC1rbol. Ella dud\xF3 de la Familia. Y la duda es una enfermedad. T\xFA
      sabes lo que hay que hacer."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Gamma
    dialogueText: "\xA1NO!  \xA1Lilith, m\xEDrame! \xA1M\xEDrame a la cara! Soy yo.
      Soy yo\u2026 \xA1ME MENTISTE!\r\n"
    leftSpeaker: 1
    characterSprite: {fileID: -5583387276452590461, guid: 005a9e797db489f44b7d1fdbbce0ce98, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "No escuches su miedo. El miedo es lo \xFAltimo que abandona a
      los d\xE9biles. Hazlo. Cumple la profec\xEDa."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Gamma
    dialogueText: "Lilith\u2026 por favor\u2026 No quiero morir aqu\xED. No as\xED\u2026
      No por \xE9l."
    leftSpeaker: 1
    characterSprite: {fileID: -5583387276452590461, guid: 005a9e797db489f44b7d1fdbbce0ce98, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: Hazlo. Es tu destino.
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: Lo siento Gamma.
    leftSpeaker: 0
    characterSprite: {fileID: -6974867021855848915, guid: 1e5f94e1a36cf434e84059be518bdf15, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: Hoy renacemos.
    leftSpeaker: 0
    characterSprite: {fileID: -6974867021855848915, guid: 1e5f94e1a36cf434e84059be518bdf15, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Gamma
    dialogueText: ...mentirosa...
    leftSpeaker: 1
    characterSprite: {fileID: 5633302920461939930, guid: d6c8d301e1d48fb4da13f6fba40281e4, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
  inventoryItemName: Nuevo Item
  objectsToActivateAfter:
  - {fileID: 587028400}
  objectsToDestroyAfter: []
  destroyAfterDialogue: 1
  autoActivate: 1
  reuseDelay: 0.5
