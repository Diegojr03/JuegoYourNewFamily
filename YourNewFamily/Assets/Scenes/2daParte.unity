--- !u!114 &1078973409
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1078973407}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58c785d1312487d48bae41c65e986f1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterLeft: {fileID: 1321065294}
  characterRight: {fileID: 2122752693}
  spriteLeft: {fileID: 1321065295}
  spriteRight: {fileID: 2122752694}
  defaultLeftSprite: {fileID: 3117115070485913476, guid: 89a097a9ff3522943969adce06e21898, type: 3}
  defaultRightSprite: {fileID: -1674950913012282259, guid: 44412b1d030bb9c40b08a3042c899310, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogues:
  - speakerName: Cael
    dialogueText: "\u2026\xBFQu\xE9 has hecho?\r"
    leftSpeaker: 1
    characterSprite: {fileID: 3117115070485913476, guid: 89a097a9ff3522943969adce06e21898, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Yo\u2026 yo solo\r\n\r"
    leftSpeaker: 0
    characterSprite: {fileID: 11193807160901837, guid: feaf89ab787e8224ea15f5b16245f391, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cael
    dialogueText: "\xA1C\xC1LLATE! \xBFSabes cu\xE1nto tiempo llevaba funcionando?
      \xBFSabes lo que era? Era progreso."
    leftSpeaker: 1
    characterSprite: {fileID: 3117115070485913476, guid: 89a097a9ff3522943969adce06e21898, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Se descontrol\xF3. Yo no sab\xEDa\u2026"
    leftSpeaker: 0
    characterSprite: {fileID: 11193807160901837, guid: feaf89ab787e8224ea15f5b16245f391, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cael
    dialogueText: "\xA1MENTIRA! Siempre toc\xE1is lo que no entend\xE9is. Da\xEDn
      confiaba en m\xED."
    leftSpeaker: 1
    characterSprite: {fileID: 381320091083652993, guid: c30510d09ef6b96409b78a54c0e93699, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cael
    dialogueText: "Y t\xFA lo has roto. Algunas heridas\u2026 Solo se curan cortando
      m\xE1s profundo."
    leftSpeaker: 1
    characterSprite: {fileID: 381320091083652993, guid: c30510d09ef6b96409b78a54c0e93699, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
  inventoryItemName: Nuevo Item
