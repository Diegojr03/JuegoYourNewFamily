  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58c785d1312487d48bae41c65e986f1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterLeft: {fileID: 430998030}
  characterRight: {fileID: 1492316438}
  spriteLeft: {fileID: 430998031}
  spriteRight: {fileID: 1492316439}
  defaultLeftSprite: {fileID: -2383032309045119739, guid: 0b6ea141e6c9c3e44b39935f08a7334a, type: 3}
  defaultRightSprite: {fileID: -2470595747785517482, guid: 1e90cf757f218af4da389c6b1ba8380b, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogueId: d05a1d6c-4a9e-42a0-9440-5b20586c44c7
  dialogues:
  - speakerName: "Da\xEDn"
    dialogueText: "\xA1AH\u2014! \xA1Lilith! \xA1LILITH, AYUDA! \xA1Me est\xE1 atravesando!
      \xA1Me est\xE1\u2014 joder\u2014!\r\n"
    leftSpeaker: 1
    characterSprite: {fileID: -2383032309045119739, guid: 0b6ea141e6c9c3e44b39935f08a7334a, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "No\u2026 no\u2026 no\u2026 Yo no quer\xEDa\u2026\r"
    leftSpeaker: 0
    characterSprite: {fileID: -2470595747785517482, guid: 1e90cf757f218af4da389c6b1ba8380b, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: "Da\xEDn"
    dialogueText: "\xA1AP\xC1GALA! \xA1AP\xC1GALA, POR FAVOR! \xA1Duele! \xA1DUELE
      MUCHO!"
    leftSpeaker: 1
    characterSprite: {fileID: -2383032309045119739, guid: 0b6ea141e6c9c3e44b39935f08a7334a, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: "Da\xEDn"
    dialogueText: "No quiero morirme aqu\xED\u2026 no as\xED\u2026 \xA1Cael dijo
      que esto me curaba! \xA1DIJO QUE ME CURABA!"
    leftSpeaker: 1
    characterSprite: {fileID: -2383032309045119739, guid: 0b6ea141e6c9c3e44b39935f08a7334a, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "No s\xE9 qu\xE9 hacer\u2026 no s\xE9 qu\xE9 tocar\u2026 Lo siento\u2026
      lo siento\u2026 lo siento\u2026"
    leftSpeaker: 0
    characterSprite: {fileID: -2470595747785517482, guid: 1e90cf757f218af4da389c6b1ba8380b, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: "Da\xEDn"
    dialogueText: "\xA1NO LO SIENTAS! \xA1Ay\xFAd\u2014 ay\xFAdame, por favor, yo
      no\u2014!"
    leftSpeaker: 1
    characterSprite: {fileID: -2383032309045119739, guid: 0b6ea141e6c9c3e44b39935f08a7334a, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: "Da\xEDn"
    dialogueText: ...
    leftSpeaker: 1
    characterSprite: {fileID: -2383032309045119739, guid: 0b6ea141e6c9c3e44b39935f08a7334a, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
