--- !u!114 &154004223
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 154004221}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58c785d1312487d48bae41c65e986f1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterLeft: {fileID: 23644431}
  characterRight: {fileID: 1809817802}
  spriteLeft: {fileID: 23644432}
  spriteRight: {fileID: 1809817803}
  defaultLeftSprite: {fileID: 718741044464532313, guid: 1e9d75a19511a6e4f8eb324595750ea4, type: 3}
  defaultRightSprite: {fileID: -1674950913012282259, guid: a5603edeb1e5a3d45a5e2ebd1a655387, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogueId: fbd1f6ca-635a-4019-8048-079384984e78
  dialogues:
  - speakerName: Amara
    dialogueText: "\u2026No entiendo. No era\u2026 no era solo un conejo, Lilith.
      Cuando Nube saltaba\u2026 el beb\xE9 se mov\xEDa. Siempre. Era como si ya se
      conocieran.\r\n"
    leftSpeaker: 1
    characterSprite: {fileID: 718741044464532313, guid: 1e9d75a19511a6e4f8eb324595750ea4, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Amara
    dialogueText: "Jesal dice que estas cosas pasan. Que el huerto\u2026 que la tierra\u2026
      que la familia\u2026 Pero yo lo dej\xE9 ir. Yo no estaba ah\xED.\n"
    leftSpeaker: 1
    characterSprite: {fileID: 718741044464532313, guid: 1e9d75a19511a6e4f8eb324595750ea4, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "No fue culpa tuya. Aqu\xED\u2026 las cosas suceden porque tienen
      que suceder.\r\n"
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: bab0a3cb2ddcbf74782f358147544b33, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Amara
    dialogueText: "\xBFDe verdad lo crees\u2026? Porque yo no puedo dejar de pensar
      que\u2026 si hubiera estado all\xED\u2026"
    leftSpeaker: 1
    characterSprite: {fileID: 718741044464532313, guid: 1e9d75a19511a6e4f8eb324595750ea4, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Pensar as\xED solo hace da\xF1o. Alpha dice que la familia nos
      cuida incluso cuando no lo entendemos.\r"
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: bab0a3cb2ddcbf74782f358147544b33, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Amara
    dialogueText: "Yo solo quer\xEDa\u2026 algo peque\xF1o. Algo vivo que no tuviera
      miedo de este sitio. Ahora siento que\u2026 que todo lo que toco\u2026\r"
    leftSpeaker: 1
    characterSprite: {fileID: 718741044464532313, guid: 1e9d75a19511a6e4f8eb324595750ea4, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Solo est\xE1s cansada.\r"
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: bab0a3cb2ddcbf74782f358147544b33, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Amara
    dialogueText: "Ojal\xE1 pudiera dejar de sentir esto. Ojal\xE1 pudiera\u2026
      no pensar.\r"
    leftSpeaker: 1
    characterSprite: {fileID: 718741044464532313, guid: 1e9d75a19511a6e4f8eb324595750ea4, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "A veces no pensar es un alivio.\r"
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: bab0a3cb2ddcbf74782f358147544b33, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Amara
    dialogueText: "Alpha dice que quiz\xE1\u2026 deber\xEDamos alejarnos un poco.
      T\xFA, Nira y yo. Dice que el bosque\u2026 ayuda a ordenar la mente.\r"
    leftSpeaker: 1
    characterSprite: {fileID: 718741044464532313, guid: 1e9d75a19511a6e4f8eb324595750ea4, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Si \xE9l lo dice\u2026 ser\xE1 lo mejor.\r"
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: bab0a3cb2ddcbf74782f358147544b33, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Amara
    dialogueText: "Gracias por ayudarme Lilith.\r"
    leftSpeaker: 1
    characterSprite: {fileID: 718741044464532313, guid: 1e9d75a19511a6e4f8eb324595750ea4, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
