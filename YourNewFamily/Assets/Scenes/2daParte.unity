--- !u!114 &1130892534
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1130892532}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58c785d1312487d48bae41c65e986f1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterLeft: {fileID: 19851098}
  characterRight: {fileID: 742924392}
  spriteLeft: {fileID: 19851099}
  spriteRight: {fileID: 742924393}
  defaultLeftSprite: {fileID: 7890750094118467228, guid: 39c03f4323687f847a2a07fa8bd90c74, type: 3}
  defaultRightSprite: {fileID: -1674950913012282259, guid: a5603edeb1e5a3d45a5e2ebd1a655387, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogueId: 22a1b9b3-fd6f-456e-bc45-571dacd6a0df
  dialogues:
  - speakerName: Lilith
    dialogueText: "\xBF\u2026Lin? No sab\xEDa que estabas aqu\xED."
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: bab0a3cb2ddcbf74782f358147544b33, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lin
    dialogueText: "No pod\xEDa\u2026 estar solo."
    leftSpeaker: 1
    characterSprite: {fileID: 2511416768324219781, guid: 1003a5fe545ff28419b9b7285e763ea5, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "\xBFQuieres hablar?"
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: bab0a3cb2ddcbf74782f358147544b33, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lin
    dialogueText: "Si me siento\u2026 no me levanto."
    leftSpeaker: 1
    characterSprite: {fileID: 2511416768324219781, guid: 1003a5fe545ff28419b9b7285e763ea5, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Lo siento Lin, no quer\xEDa que Am..."
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: bab0a3cb2ddcbf74782f358147544b33, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lin
    dialogueText: "No digas su nombre as\xED."
    leftSpeaker: 1
    characterSprite: {fileID: -499978008167884108, guid: 289f38130c653a941aa0550755005a04, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "\xBFEl de Amara?"
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: bab0a3cb2ddcbf74782f358147544b33, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lin
    dialogueText: Ella confiaba en ti.
    leftSpeaker: 1
    characterSprite: {fileID: 2511416768324219781, guid: 1003a5fe545ff28419b9b7285e763ea5, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Yo tambi\xE9n confiaba en ella."
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: bab0a3cb2ddcbf74782f358147544b33, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lin
    dialogueText: "No es lo mismo. Cuando dijo que iba a salir\u2026 yo dud\xE9.
      Sent\xED algo raro."
    leftSpeaker: 1
    characterSprite: {fileID: 2511416768324219781, guid: 1003a5fe545ff28419b9b7285e763ea5, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lin
    dialogueText: "Pero Alpha dijo que era bueno. Y t\xFA dijiste que era bueno."
    leftSpeaker: 1
    characterSprite: {fileID: 2511416768324219781, guid: 1003a5fe545ff28419b9b7285e763ea5, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Nadie se esperaba que pasar\xEDa eso."
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: bab0a3cb2ddcbf74782f358147544b33, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lin
    dialogueText: "Siempre dec\xEDs eso. Siempre pasa algo y luego nadie sabe nada."
    leftSpeaker: 1
    characterSprite: {fileID: 2511416768324219781, guid: 1003a5fe545ff28419b9b7285e763ea5, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Lin\u2026 por favor baja la voz."
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: bab0a3cb2ddcbf74782f358147544b33, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lin
    dialogueText: "No puedo. \xBFSabes qu\xE9 hice cuando no volvisteis? Me sent\xE9.
      Esper\xE9."
    leftSpeaker: 1
    characterSprite: {fileID: 2511416768324219781, guid: 1003a5fe545ff28419b9b7285e763ea5, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lin
    dialogueText: "Pens\xE9 que si no me mov\xEDa\u2026 el tiempo volver\xEDa atr\xE1s.
      Pero solo volvi\xF3 el silencio. Y ahora t\xFA sigues aqu\xED."
    leftSpeaker: 1
    characterSprite: {fileID: 2511416768324219781, guid: 1003a5fe545ff28419b9b7285e763ea5, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: Eso no signifi...
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: bab0a3cb2ddcbf74782f358147544b33, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lin
    dialogueText: "\xA1SIGNIFICA QUE TU PUEDES SEGUIR!"
    leftSpeaker: 1
    characterSprite: {fileID: -499978008167884108, guid: 289f38130c653a941aa0550755005a04, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: 'Lin, para '
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: bab0a3cb2ddcbf74782f358147544b33, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lin
    dialogueText: "No me digas qu\xE9 hacer. No me queda nada."
    leftSpeaker: 1
    characterSprite: {fileID: -499978008167884108, guid: 289f38130c653a941aa0550755005a04, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: LIlith
    dialogueText: "Lin\u2026 por favor."
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: bab0a3cb2ddcbf74782f358147544b33, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
