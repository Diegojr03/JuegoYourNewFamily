--- !u!114 &1808349915
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1808349911}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58c785d1312487d48bae41c65e986f1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterLeft: {fileID: 1465205422}
  characterRight: {fileID: 1370078336}
  spriteLeft: {fileID: 1465205423}
  spriteRight: {fileID: 1370078337}
  defaultLeftSprite: {fileID: -4645891115520188566, guid: a70f31b39fac24149a2d4654314875af, type: 3}
  defaultRightSprite: {fileID: 7101044242358493641, guid: 0c34a2ac23cef364db5433cf4854f924, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogues:
  - speakerName: Amara
    dialogueText: "\xBFPor qu\xE9\u2026? \xBFPor qu\xE9 \xE9l\u2026? \xBFPor qu\xE9
      Nube\u2026?"
    leftSpeaker: 1
    characterSprite: {fileID: 0}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lin
    dialogueText: "Amara no\u2026 no llores as\xED por favor\u2026 vamos a\u2026
      podemos\u2026"
    leftSpeaker: 0
    characterSprite: {fileID: -4920136608581562092, guid: 3687bfad6f495db4d90baf3fbf03ad8e, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Amara
    dialogueText: "\xA1ERA SOLO UN BEB\xC9!"
    leftSpeaker: 1
    characterSprite: {fileID: 0}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Amara
    dialogueText: "Solo\u2026 solo quer\xEDa estar cerca\u2026 solo quer\xEDa saltar\u2026
      respirar\u2026 vivir\u2026\r           \r\n"
    leftSpeaker: 1
    characterSprite: {fileID: -4645891115520188566, guid: a70f31b39fac24149a2d4654314875af, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Amara
    dialogueText: "\xBFQui\xE9n har\xEDa algo as\xED\u2026? \xBFQui\xE9n\u2026 qui\xE9n
      ser\xEDa capaz\u2026? Nube nunca hizo da\xF1o a nadie\u2026 nunca\u2026"
    leftSpeaker: 1
    characterSprite: {fileID: -4645891115520188566, guid: a70f31b39fac24149a2d4654314875af, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lin
    dialogueText: "Estoy aqu\xED, estoy contigo\u2026 no est\xE1s sola te lo juro"
    leftSpeaker: 0
    characterSprite: {fileID: -4920136608581562092, guid: 3687bfad6f495db4d90baf3fbf03ad8e, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Amara
    dialogueText: "\xBFY si le pasa lo mismo al beb\xE9, Lin? \xBFY si\u2026 si este
      lugar lo consume\u2026 igual que a Nube\u2026?"
    leftSpeaker: 1
    characterSprite: {fileID: -4645891115520188566, guid: a70f31b39fac24149a2d4654314875af, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Amara
    dialogueText: "No s\xE9 qu\xE9 hacer\u2026 no s\xE9 c\xF3mo proteger a nadie\u2026"
    leftSpeaker: 1
    characterSprite: {fileID: -4645891115520188566, guid: a70f31b39fac24149a2d4654314875af, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Amara
    dialogueText: "Se supon\xEDa que este era un hogar..."
    leftSpeaker: 1
    characterSprite: {fileID: -4645891115520188566, guid: a70f31b39fac24149a2d4654314875af, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lin
    dialogueText: "Vamonos Amara, te vendr\xE1 bien descansar"
    leftSpeaker: 0
    characterSprite: {fileID: -4920136608581562092, guid: 3687bfad6f495db4d90baf3fbf03ad8e, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
  inventoryItemName: Nuevo Item
