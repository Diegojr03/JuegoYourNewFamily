  defaultLeftSprite: {fileID: 6021040597011648977, guid: 331ed2a063eafdc4e9c115f301376c30, type: 3}
  defaultRightSprite: {fileID: -1674950913012282259, guid: a5603edeb1e5a3d45a5e2ebd1a655387, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogueId: 51b77d10-4d26-44f1-8d9e-e4f4e6c0983f
  dialogues:
  - speakerName: Orren
    dialogueText: "\xBFLilith? Estaba buscando un libro nuevo. Hay algunos que me
      brindan nuevas t\xE9cnicas para la costura.\n"
    leftSpeaker: 1
    characterSprite: {fileID: -1303178727368756583, guid: 8f04080569460f8439677618d49b65a8, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Hola, Orren. Te buscaba para recoger algo de tela, para un regalo.
      Me env\xEDa Lin"
    leftSpeaker: 0
    characterSprite: {fileID: 6377917850455477399, guid: 25e65e92d43918b438de921ced967a6a, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Orren
    dialogueText: "Ah, s\xED, s\xED, claro. Recuerdo lo que me pidi\xF3, para su
      hijo, \xBFverdad? Aqu\xED tengo la tela que buscas.\n"
    leftSpeaker: 1
    characterSprite: {fileID: -1303178727368756583, guid: 8f04080569460f8439677618d49b65a8, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: Muchas gracias Orren!
    leftSpeaker: 0
    characterSprite: {fileID: -3582710704502222356, guid: 03b328f3d751c38429f3af6a3895348b, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
