MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1013331942}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58c785d1312487d48bae41c65e986f1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterLeft: {fileID: 793005844}
  characterRight: {fileID: 1904291896}
  spriteLeft: {fileID: 793005845}
  spriteRight: {fileID: 1904291897}
  defaultLeftSprite: {fileID: 5028499325454563662, guid: d50fcecbde20f7a47aa2d3e4ebf5f761, type: 3}
  defaultRightSprite: {fileID: 3648207892980098720, guid: 5e6902c4807b72d4187c413fa5d64f65, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogues:
  - speakerName: "Da\xEDn"
    dialogueText: "A ti no te he visto antes. \xBFEres nueva?"
    leftSpeaker: 1
    characterSprite: {fileID: -1851721968044057121, guid: f674f01a4746d28429ee4bdb4f00a84e, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "\u2026s\xED."
    leftSpeaker: 0
    characterSprite: {fileID: 6471638616864330708, guid: 2a2fa987fe86a67449a285a606665d8b, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: "Da\xEDn"
    dialogueText: "Soy Da\xEDn. El doctor dice que soy su mejor paciente."
    leftSpeaker: 1
    characterSprite: {fileID: -1851721968044057121, guid: f674f01a4746d28429ee4bdb4f00a84e, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "\xBFTe\u2026 duele mucho?"
    leftSpeaker: 0
    characterSprite: {fileID: 6471638616864330708, guid: 2a2fa987fe86a67449a285a606665d8b, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: "Da\xEDn"
    dialogueText: "Antes s\xED. Ahora solo cuando va bien. (Sonr\xEDe)"
    leftSpeaker: 1
    characterSprite: {fileID: -1851721968044057121, guid: f674f01a4746d28429ee4bdb4f00a84e, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Eso no suena\u2026 bien."
    leftSpeaker: 0
    characterSprite: {fileID: 6471638616864330708, guid: 2a2fa987fe86a67449a285a606665d8b, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: "Da\xEDn"
    dialogueText: "Es que no lo entiendes todav\xEDa. Cuando mejore, el Cael estar\xE1
      orgulloso."
    leftSpeaker: 1
    characterSprite: {fileID: -1851721968044057121, guid: f674f01a4746d28429ee4bdb4f00a84e, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Espero que\u2026 te cures."
    leftSpeaker: 0
    characterSprite: {fileID: 6471638616864330708, guid: 2a2fa987fe86a67449a285a606665d8b, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: "Da\xEDn"
    dialogueText: "Lo har\xE9. Encantado Lilith."
    leftSpeaker: 1
    characterSprite: {fileID: -1851721968044057121, guid: f674f01a4746d28429ee4bdb4f00a84e, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
