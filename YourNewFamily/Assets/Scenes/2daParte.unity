    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Amara
    dialogueText: "\xA1Nube! Ay qu\xE9 alivio. Gracias, Lilith. En serio, no s\xE9
      qu\xE9 habr\xEDa hecho si\u2026"
    leftSpeaker: 1
    characterSprite: {fileID: -2145651702438150279, guid: 627580a089281b14288222df3486b075, type: 3}
