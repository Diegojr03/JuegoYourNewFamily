  dialogues:
  - speakerName: Nira
    dialogueText: "Aqu\xED\u2026 el ruido se apaga un poco."
    leftSpeaker: 1
    characterSprite: {fileID: -7441966514919091945, guid: 9f9fe1a63c320df4db63aba074738e18, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Nira
    dialogueText: "A veces pienso que, si respiro hondo, todo vuelve a su sitio\u2026
      aunque sea por un rato."
    leftSpeaker: 1
    characterSprite: {fileID: -7441966514919091945, guid: 9f9fe1a63c320df4db63aba074738e18, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Nira
    dialogueText: "Gracias por venir. Me hac\xEDa falta no estar sola con mis pensamientos."
    leftSpeaker: 1
    characterSprite: {fileID: -7441966514919091945, guid: 9f9fe1a63c320df4db63aba074738e18, type: 3}
    giveItemAfterThisLine: 0
