MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1013331942}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58c785d1312487d48bae41c65e986f1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterLeft: {fileID: 793005844}
  characterRight: {fileID: 1904291896}
  spriteLeft: {fileID: 793005845}
  spriteRight: {fileID: 1904291897}
  defaultLeftSprite: {fileID: 5128570580311282821, guid: 5855e066a11e613408dcc9b3ae97d69c, type: 3}
  defaultRightSprite: {fileID: 3648207892980098720, guid: 0c6a7482622f9b3428899aa606073ac2, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogueId: 33cb19b4-f88f-4cdc-921f-e5483c5389c2
  dialogues:
  - speakerName: "Da\xEDn"
    dialogueText: "A ti no te he visto antes. \xBFEres nueva?"
    leftSpeaker: 1
    characterSprite: {fileID: 1078185386979141445, guid: 43512f9c95340bd4cbba2ba8580fb838, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "\u2026s\xED."
    leftSpeaker: 0
    characterSprite: {fileID: 6471638616864330708, guid: bbb9b4119138bfc418c8bdf3c7807b1a, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: "Da\xEDn"
    dialogueText: "Soy Da\xEDn. El doctor dice que soy su mejor paciente."
    leftSpeaker: 1
    characterSprite: {fileID: 1078185386979141445, guid: 43512f9c95340bd4cbba2ba8580fb838, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "\xBFTe\u2026 duele mucho?"
    leftSpeaker: 0
    characterSprite: {fileID: 6471638616864330708, guid: bbb9b4119138bfc418c8bdf3c7807b1a, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: "Da\xEDn"
    dialogueText: "Antes s\xED. Ahora solo cuando va bien. (Sonr\xEDe)"
    leftSpeaker: 1
    characterSprite: {fileID: 1078185386979141445, guid: 43512f9c95340bd4cbba2ba8580fb838, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Eso no suena\u2026 bien."
    leftSpeaker: 0
    characterSprite: {fileID: 6471638616864330708, guid: bbb9b4119138bfc418c8bdf3c7807b1a, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: "Da\xEDn"
    dialogueText: "Es que no lo entiendes todav\xEDa. Cuando mejore, el Cael estar\xE1
      orgulloso."
    leftSpeaker: 1
    characterSprite: {fileID: 1078185386979141445, guid: 43512f9c95340bd4cbba2ba8580fb838, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Espero que\u2026 te cures."
    leftSpeaker: 0
    characterSprite: {fileID: 6471638616864330708, guid: bbb9b4119138bfc418c8bdf3c7807b1a, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: "Da\xEDn"
    dialogueText: "Lo har\xE9. Encantado Lilith."
    leftSpeaker: 1
    characterSprite: {fileID: 1078185386979141445, guid: 43512f9c95340bd4cbba2ba8580fb838, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
  inventoryItemName: Nuevo Item
