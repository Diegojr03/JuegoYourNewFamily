    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Ha llegado m\xE1s lejos que nadie.\r"
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Delta
    dialogueText: "Lo sab\xEDa. Desde el principio lo supe. El n\xE9ctar nunca ha
      estado tan bueno como hoy.\r"
    leftSpeaker: 1
    characterSprite: {fileID: 0}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Te ayudar\xE1 a entender.\r"
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Delta
    dialogueText: "No necesito entender nada. Solo necesito saber qu\xE9 quieres
      que haga.\r"
    leftSpeaker: 1
    characterSprite: {fileID: 0}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "La profec\xEDa debe cumplirse.\r"
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Delta
    dialogueText: "Claro que s\xED. Todo por la familia. Ah\u2026 ya veo. As\xED
      que es as\xED. Tiene sentido. Siempre dijiste que cuando llegara el momento
      habr\xEDa que darlo todo.\r"
    leftSpeaker: 1
    characterSprite: {fileID: 0}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Y t\xFA siempre dijiste que lo har\xEDas.\r"
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Delta
    dialogueText: "Por supuesto que s\xED. Vamos, Lilith. Hazlo bien. No me gustar\xEDa
      que Alpha pensara que eligi\xF3 mal.\r"
    leftSpeaker: 1
    characterSprite: {fileID: 0}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Por la familia.\r"
    leftSpeaker: 0
    characterSprite: {fileID: -1121051369868863206, guid: 0a17a5f454453e1409307adaaaebc6e2, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Delta
    dialogueText: Por la familia.
    leftSpeaker: 1
    characterSprite: {fileID: 0}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Por la familia.\r"
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Delta
    dialogueText: ...
    leftSpeaker: 1
    characterSprite: {fileID: 6298100786066847019, guid: ec74099bedf54334abac28e4b598aa6d, type: 3}
