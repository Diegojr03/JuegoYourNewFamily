  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58c785d1312487d48bae41c65e986f1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterLeft: {fileID: 688821436}
  characterRight: {fileID: 1726581660}
  spriteLeft: {fileID: 688821437}
  spriteRight: {fileID: 1726581661}
  defaultLeftSprite: {fileID: -4619670943869267955, guid: f32ef92719b8b6549a97dde3efd9f71c, type: 3}
  defaultRightSprite: {fileID: 3648207892980098720, guid: 5e6902c4807b72d4187c413fa5d64f65, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogues:
  - speakerName: Delta
    dialogueText: Lilith
    leftSpeaker: 1
    characterSprite: {fileID: -311131714167770203, guid: 93af13f8c3e47754583584387ce06a27, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: 'LIlith '
    dialogueText: Tengo que ver a Alpha
    leftSpeaker: 0
    characterSprite: {fileID: 6471638616864330708, guid: 2a2fa987fe86a67449a285a606665d8b, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Delta
    dialogueText: No
    leftSpeaker: 1
    characterSprite: {fileID: -311131714167770203, guid: 93af13f8c3e47754583584387ce06a27, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: Ha pasado algo
    leftSpeaker: 0
    characterSprite: {fileID: 6471638616864330708, guid: 2a2fa987fe86a67449a285a606665d8b, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Delta
    dialogueText: "Lo s\xE9, ve a la enfermer\xEDa de Cael. Ahora"
    leftSpeaker: 1
    characterSprite: {fileID: -311131714167770203, guid: 93af13f8c3e47754583584387ce06a27, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: Pero estoy toda manchada de sangre
    leftSpeaker: 0
    characterSprite: {fileID: 6471638616864330708, guid: 2a2fa987fe86a67449a285a606665d8b, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Delta
    dialogueText: "Di que te has tropezado. Para llegar a la enfermer\xEDa pasa por
      la biblioteca"
    leftSpeaker: 1
    characterSprite: {fileID: -311131714167770203, guid: 93af13f8c3e47754583584387ce06a27, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Pero... \xBFy Lin?"
    leftSpeaker: 0
    characterSprite: {fileID: 6471638616864330708, guid: 2a2fa987fe86a67449a285a606665d8b, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Delta
    dialogueText: "Yo me encargo de todo. Ve. T\xF3mate esto, te vendr\xE1 bien.\r"
    leftSpeaker: 1
    characterSprite: {fileID: -311131714167770203, guid: 93af13f8c3e47754583584387ce06a27, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: 
    dialogueText: "*Bebes el n\xE9ctar que te ha dado Delta*\r  "
    leftSpeaker: 0
    characterSprite: {fileID: -6751318744405601006, guid: 377001099d54d0f478295771fe716d43, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
