    characterSprite: {fileID: -4831706047985285938, guid: 06e3e07abd727584c8ebc7318360d8b6, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Oye de verdad que estoy bien, solo me he ca\xEDdo. No te preocupes
      Gamma. voy a ver a Cael para que me ayude."
    leftSpeaker: 0
    characterSprite: {fileID: 6471638616864330708, guid: bbb9b4119138bfc418c8bdf3c7807b1a, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Gamma
    dialogueText: "\xA1Vale!, ten mas cuidado la proxima vez."
    leftSpeaker: 1
    characterSprite: {fileID: -4831706047985285938, guid: 06e3e07abd727584c8ebc7318360d8b6, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "(S\xED, seguro)"
    leftSpeaker: 0
    characterSprite: {fileID: 6471638616864330708, guid: bbb9b4119138bfc418c8bdf3c7807b1a, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
