  m_Script: {fileID: 11500000, guid: dbc22598762463945aebb97aba4847d6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueId: 22c4cc22-bab1-4a7c-b7d2-f1d56f0a27ae
  protagonistName: Lilith
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
  inventoryItemName: Nuevo Item
  dialogueLines:
  - speakerName: Delta
    dialogueText: "Buenos d\xEDas Lilith, dime\u2026 \xBFhas visto a Gamma por aqu\xED?"
    leftSpeaker: 1
    characterSprite: {fileID: -311131714167770203, guid: 97fa321f5b36dfa46bc8e7c875e1c5c3, type: 3}
    endDialogueHere: 0
    choices:
    - choiceText: "No, no la he visto hoy\u2026 \xBFpor qu\xE9?"
      nextDialogueIndex: 1
    - choiceText: "\xBFEst\xE1 pasando algo con ella?"
      nextDialogueIndex: 1
    - choiceText: "No\u2026 \xBFdeber\xEDa preocuparme?"
      nextDialogueIndex: 1
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Delta
    dialogueText: "Si la ves d\xEDmelo, necesito hablar con ella"
    leftSpeaker: 1
    characterSprite: {fileID: -311131714167770203, guid: 97fa321f5b36dfa46bc8e7c875e1c5c3, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "\xBFVale\u2026?"
    leftSpeaker: 0
    characterSprite: {fileID: -793861177819025959, guid: a0d3b193b6e13604f814ddfdaef6455f, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Delta
    dialogueText: "Por cierto, p\xE1sate por la zona de caba\xF1as, me preguntaron
      por ti."
    leftSpeaker: 1
    characterSprite: {fileID: -311131714167770203, guid: 97fa321f5b36dfa46bc8e7c875e1c5c3, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
