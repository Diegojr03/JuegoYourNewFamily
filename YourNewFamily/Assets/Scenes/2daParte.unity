  spriteRight: {fileID: 253802900}
  defaultLeftSprite: {fileID: -4248094021219397344, guid: a59cd75d32018cb46a26095b3897cc5b, type: 3}
  defaultRightSprite: {fileID: -1674950913012282259, guid: a5603edeb1e5a3d45a5e2ebd1a655387, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogueId: cb4e2892-013a-4b5d-a66d-faa086f0be6d
  dialogues:
  - speakerName: Cael
    dialogueText: "Nada grave. Ara\xF1azos y hematomas leves. Te recuperar\xE1s r\xE1pido....
      Da\xEDn necesita supervisi\xF3n, ay\xFAdame Lilith."
    leftSpeaker: 1
    characterSprite: {fileID: -2707006300247289298, guid: ade374c91e22aab4ca5688fbb312b4cf, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "\xBFYo?"
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: bab0a3cb2ddcbf74782f358147544b33, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cael
    dialogueText: "Es sencillo. Aseg\xFArate de que la m\xE1quina que tiene al lado
      no deje de funcionar."
    leftSpeaker: 1
    characterSprite: {fileID: -2707006300247289298, guid: ade374c91e22aab4ca5688fbb312b4cf, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cael
    dialogueText: "Si el sonido cambia, av\xEDsame. Tengo asuntos urgentes que atender."
    leftSpeaker: 1
    characterSprite: {fileID: -2707006300247289298, guid: ade374c91e22aab4ca5688fbb312b4cf, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
