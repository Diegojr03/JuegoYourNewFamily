--- !u!114 &1208023558
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1208023556}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58c785d1312487d48bae41c65e986f1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterLeft: {fileID: 2057902250}
  characterRight: {fileID: 311538531}
  spriteLeft: {fileID: 2057902251}
  spriteRight: {fileID: 311538532}
  defaultLeftSprite: {fileID: 4704073244319040601, guid: c1b0d59a8d93aa2449c22bd17735a03d, type: 3}
  defaultRightSprite: {fileID: -1674950913012282259, guid: a5603edeb1e5a3d45a5e2ebd1a655387, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogueId: 5319d06c-92c2-4dd2-9179-3ea583cda137
  dialogues:
  - speakerName: Gamma
    dialogueText: "\xA1LILITH! Menos mal que eres t\xFA."
    leftSpeaker: 1
    characterSprite: {fileID: -4831706047985285938, guid: 06e3e07abd727584c8ebc7318360d8b6, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: Gamma...
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: bab0a3cb2ddcbf74782f358147544b33, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Gamma
    dialogueText: "Joder,  pens\xE9 que morir\xEDa aqu\xED Me encerraron aqu\xED.
      No s\xE9 desde cu\xE1ndo\u2026 horas, quiz\xE1 m\xE1s."
    leftSpeaker: 1
    characterSprite: {fileID: -4831706047985285938, guid: 06e3e07abd727584c8ebc7318360d8b6, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Gamma
    dialogueText: "V\xED a Alpha guardando unos cartuchos de dinamita, le dijo a
      Delta que los utilizase para algo de una profec\xEDa. "
    leftSpeaker: 1
    characterSprite: {fileID: -4831706047985285938, guid: 06e3e07abd727584c8ebc7318360d8b6, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Gamma
    dialogueText: "Creo que no deber\xEDa haberlo visto, supongo que por eso estoy
      aqu\xED. Siempre he confiado en que me encontrar\xEDas. "
    leftSpeaker: 1
    characterSprite: {fileID: -4831706047985285938, guid: 06e3e07abd727584c8ebc7318360d8b6, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Gamma
    dialogueText: "Siempre has sido la \xFAnica aqu\xED con cabeza. Pero Lilith,
      \xBFpor qu\xE9 est\xE1 Delta muerto?"
    leftSpeaker: 1
    characterSprite: {fileID: -4831706047985285938, guid: 06e3e07abd727584c8ebc7318360d8b6, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: Las cosas han cambiado.
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: bab0a3cb2ddcbf74782f358147544b33, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Gamma
    dialogueText: "Ya me lo imaginaba. Escucha. Algo no va bien en este sitio. Alpha
      tiene un plan, le escuche diciendo que conseguir\xE1 reunirse con Beta."
    leftSpeaker: 1
    characterSprite: {fileID: -4831706047985285938, guid: 06e3e07abd727584c8ebc7318360d8b6, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Gamma
    dialogueText: "Creo que est\xE1 preparando algo. Y si Delta est\xE1 muerto\u2026
      significa que ya ha empezado. Necesito salir de aqu\xED, ay\xFAdame Lilith."
    leftSpeaker: 1
    characterSprite: {fileID: -4831706047985285938, guid: 06e3e07abd727584c8ebc7318360d8b6, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Gamma
    dialogueText: "Tenemos que salir de aqu\xED juntas. El hueco no es suficiente
      para pasar. Pero t\xFA est\xE1s al otro lado. Si alguien puede ayudarme\u2026
      eres t\xFA."
    leftSpeaker: 1
    characterSprite: {fileID: -4831706047985285938, guid: 06e3e07abd727584c8ebc7318360d8b6, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Desde aqu\xED no puedo hacer nada Gamma. D\xE9jame que investigue
      a ver si te puedo sacar de ah\xED."
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: bab0a3cb2ddcbf74782f358147544b33, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Gamma
    dialogueText: "Sab\xEDa que pod\xEDa confiar en ti. Siempre lo supe. Solo\u2026
      no tardes."
    leftSpeaker: 1
    characterSprite: {fileID: -4831706047985285938, guid: 06e3e07abd727584c8ebc7318360d8b6, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
