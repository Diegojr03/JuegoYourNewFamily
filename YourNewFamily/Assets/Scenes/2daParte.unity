  spriteRight: {fileID: 1968588242}
  defaultLeftSprite: {fileID: 6021040597011648977, guid: a0c2ecdd8ed66b546a6e7a75b77d85d7, type: 3}
  defaultRightSprite: {fileID: -1674950913012282259, guid: 44412b1d030bb9c40b08a3042c899310, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogues:
  - speakerName: Orren
    dialogueText: "\xBFLilith? Estaba buscando un libro nuevo. Hay algunos que me
      brindan nuevas t\xE9cnicas para la costura.\n"
    leftSpeaker: 1
    characterSprite: {fileID: -1303178727368756583, guid: ac7b01b7cb2861c499489c4be1d3760f, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Hola, Orren. Te buscaba para recoger algo de tela, para un regalo.
      Me env\xEDa Lin"
    leftSpeaker: 0
    characterSprite: {fileID: 6377917850455477399, guid: b3555c8a1e4ebba4e84c64c3e0c1ec36, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Orren
    dialogueText: "Ah, s\xED, s\xED, claro. Recuerdo lo que me pidi\xF3, para su
      hijo, \xBFverdad? Aqu\xED tengo la tela que buscas.\n"
    leftSpeaker: 1
    characterSprite: {fileID: -1303178727368756583, guid: ac7b01b7cb2861c499489c4be1d3760f, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: Muchas gracias Orren!
    leftSpeaker: 0
    characterSprite: {fileID: 6078937715035284617, guid: 3b75265a4a27f5a4fb33fc22daf3f5f1, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
