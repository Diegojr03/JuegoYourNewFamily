  defaultRightSprite: {fileID: 3648207892980098720, guid: 5e6902c4807b72d4187c413fa5d64f65, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogues:
  - speakerName: Orren
    dialogueText: "Oye Lilith... y todas esas heridas, \xBFestas bien?"
    leftSpeaker: 1
    characterSprite: {fileID: -1303178727368756583, guid: ac7b01b7cb2861c499489c4be1d3760f, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Orren, solo me he caido vale?, voy de camino a la enfermer\xEDa."
    leftSpeaker: 0
    characterSprite: {fileID: 6471638616864330708, guid: 2a2fa987fe86a67449a285a606665d8b, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Orren
    dialogueText: "Quieres que te acompa\xF1e?"
    leftSpeaker: 1
    characterSprite: {fileID: -1303178727368756583, guid: ac7b01b7cb2861c499489c4be1d3760f, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
