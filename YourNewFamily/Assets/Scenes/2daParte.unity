  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58c785d1312487d48bae41c65e986f1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterLeft: {fileID: 2139563508}
  characterRight: {fileID: 594332049}
  spriteLeft: {fileID: 2139563509}
  spriteRight: {fileID: 594332050}
  defaultLeftSprite: {fileID: 2254904283701343870, guid: cebec0d58053dfa4d93867dae2b40fc3, type: 3}
  defaultRightSprite: {fileID: -1674950913012282259, guid: 44412b1d030bb9c40b08a3042c899310, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogues:
  - speakerName: Cairen
    dialogueText: "Lilith. Me alegra verte. Ellas son mis hermanas peque\xF1as. Jase\u2026
      y Jesal. Bueno, a Jesal ya la conoces"
    leftSpeaker: 1
    characterSprite: {fileID: 6775278750140180628, guid: 4996e8616930a4947817a517bd018a82, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Jesal
    dialogueText: Hola Lilith!
    leftSpeaker: 1
    characterSprite: {fileID: -325410527933720274, guid: 24dbb70e582dffd48822c8c6bfb8a87a, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Jase
    dialogueText: ...
    leftSpeaker: 1
    characterSprite: {fileID: 4337371268907828743, guid: ceb2ae5d167bd5440aa927647558757e, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "Siempre han estado conmigo. Desde antes de llegar aqu\xED. Este
      sitio les ha dado orden. Seguridad. Eso dicen."
    leftSpeaker: 1
    characterSprite: {fileID: -7517056936566813833, guid: 432576f5d3f550b48809ee9457d15b53, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "Por cierto, \xBFpodemos hablar un momento? A solas."
    leftSpeaker: 1
    characterSprite: {fileID: 6775278750140180628, guid: 4996e8616930a4947817a517bd018a82, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: Claro, sin problema
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: 2fd71506cd35b37499404742fc662a69, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
