  defaultRightSprite: {fileID: -1674950913012282259, guid: 44412b1d030bb9c40b08a3042c899310, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogues:
  - speakerName: Lilith
    dialogueText: "Amara, mira, lo encontr\xE9. Estaba escondido detr\xE1s de unas
      cajas en un granero."
    leftSpeaker: 0
    characterSprite: {fileID: 6078937715035284617, guid: 3b75265a4a27f5a4fb33fc22daf3f5f1, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Amara
    dialogueText: "\xA1Nube! Ay qu\xE9 alivio. Gracias, Lilith. En serio, no s\xE9
      qu\xE9 habr\xEDa hecho si\u2026"
    leftSpeaker: 1
    characterSprite: {fileID: -2145651702438150279, guid: 627580a089281b14288222df3486b075, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Amara
    dialogueText: "De verdad, significas m\xE1s para m\xED de lo que crees. Gracias
      por ayudarme."
    leftSpeaker: 1
    characterSprite: {fileID: -2145651702438150279, guid: 627580a089281b14288222df3486b075, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: Muchas gracias Amara
    leftSpeaker: 0
    characterSprite: {fileID: 6377917850455477399, guid: b3555c8a1e4ebba4e84c64c3e0c1ec36, type: 3}
    giveItemAfterThisLine: 0
