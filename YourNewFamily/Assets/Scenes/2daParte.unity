--- !u!114 &1078973409
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1078973407}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58c785d1312487d48bae41c65e986f1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterLeft: {fileID: 1321065294}
  characterRight: {fileID: 2122752693}
  spriteLeft: {fileID: 1321065295}
  spriteRight: {fileID: 2122752694}
  defaultLeftSprite: {fileID: 2928949704243705097, guid: db0da78eaf33bc04bb1b7c1ec9838136, type: 3}
  defaultRightSprite: {fileID: -1674950913012282259, guid: a5603edeb1e5a3d45a5e2ebd1a655387, type: 3}
  dialoguePanel: {fileID: 878597090}
  speakerText: {fileID: 160613714}
  dialogueText: {fileID: 419537938}
  speakerContainer: {fileID: 1723153709}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogueId: 3bdc4808-8a38-4738-a071-4931d1dce6f1
  dialogues:
  - speakerName: Cael
    dialogueText: "\u2026\xBFQu\xE9 has hecho?\r"
    leftSpeaker: 1
    characterSprite: {fileID: 3117115070485913476, guid: 01da4ef0a4157a546a1cd8b24cef0e08, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Yo\u2026 yo solo\r\n\r"
    leftSpeaker: 0
    characterSprite: {fileID: 11193807160901837, guid: d47d2c5d8efee124f99a0bfe41b25392, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cael
    dialogueText: "\xA1C\xC1LLATE! \xBFSabes cu\xE1nto tiempo llevaba funcionando?
      \xBFSabes lo que era? Era progreso."
    leftSpeaker: 1
    characterSprite: {fileID: 3117115070485913476, guid: 01da4ef0a4157a546a1cd8b24cef0e08, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Se descontrol\xF3. Yo no sab\xEDa\u2026"
    leftSpeaker: 0
    characterSprite: {fileID: 11193807160901837, guid: d47d2c5d8efee124f99a0bfe41b25392, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cael
    dialogueText: "\xA1MENTIRA! Siempre toc\xE1is lo que no entend\xE9is. Da\xEDn
      confiaba en m\xED."
    leftSpeaker: 1
    characterSprite: {fileID: -4597572049980403918, guid: 169173becb20bba4f8df5e32edb549b1, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cael
    dialogueText: "Y t\xFA lo has roto. Algunas heridas\u2026 Solo se curan cortando
      m\xE1s profundo."
    leftSpeaker: 1
    characterSprite: {fileID: -4597572049980403918, guid: 169173becb20bba4f8df5e32edb549b1, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
