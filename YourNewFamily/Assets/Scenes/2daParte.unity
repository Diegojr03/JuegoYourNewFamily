  autoActivate: 1
  guardarEnBacklog: 0
  dialogueSections:
  - speakerName: Lilith
    dialogueText: "No quer\xEDa\u2026 solo\u2026 que parara\u2026 Amara\u2026 yo\u2026
      no supe cuidarte\u2026 no te vayas\u2026 tengo fr\xEDo\u2026"
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "\u2026no. No, no, no\u2026 Para\u2026 para, por favor\u2026 Yo\u2026
      yo estoy aqu\xED\u2026 Lin\u2026 m\xEDrame\u2026 \u2026no\u2026 "
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "No ten\xEDa que acabar as\xED\u2026 no quer\xEDa\u2026 Tengo que
      encontrar a Alpha, tengo que\u2026 Encontrar\u2026 a Alpha"
    giveItemAfterThisLine: 0
