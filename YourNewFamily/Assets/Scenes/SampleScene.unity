MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1178223626}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f69405e443069f544b51770be0c0f5f6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueId: 54c7a1f1-e3ee-44b2-918c-e4fcdb26af47
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
  inventoryItemName: Nuevo Item
  textSpeed: 0.05
  autoActivate: 0
  guardarEnBacklog: 0
  dialogueSections:
  - speakerName: NPC A
    dialogueText: "No puedo creer que le vendiera mi guitarra por este boleto. Era
      lo \xFAltimo que me quedaba de mi abuelo."
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: NPC B
    dialogueText: "Callate, hijo. Lo material vuelve. El alma, no. A m\xED me echaron
      de mi propia casa... mis hijos... "
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: NPC B
    dialogueText: "prefirieron un asilo a cuidarme. Alfa me dio una mano cuando nadie
      m\xE1s lo hizo."
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: NPC A
    dialogueText: "S\xED, pero... \xBFy esto ser\xE1 seguro? Lo he pensado."
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: NPC B
    dialogueText: "\xBFY qu\xE9? \xBFCrees que lo que dejamos atr\xE1s era mejor? "
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: NPC B
    dialogueText: "Un lugar con un techo y comida caliente suena mejor que la libertad
      en un parque fr\xEDo."
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  dialoguePanel: {fileID: 1834269160}
  speakerContainer: {fileID: 1863344623}
  speakerText: {fileID: 1659188321}
  dialogueText: {fileID: 78300818}
