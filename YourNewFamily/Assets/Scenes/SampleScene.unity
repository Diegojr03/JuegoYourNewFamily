  defaultRightSprite: {fileID: -1674950913012282259, guid: a5603edeb1e5a3d45a5e2ebd1a655387, type: 3}
  dialoguePanel: {fileID: 1834269160}
  speakerText: {fileID: 1659188321}
  dialogueText: {fileID: 78300818}
  speakerContainer: {fileID: 1863344623}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogueId: 86e37fd2-252b-4e6c-86c0-676641555b0d
  dialogues:
  - speakerName: Cairen
    dialogueText: Encantado de conocerte, Lilith
    leftSpeaker: 1
    characterSprite: {fileID: -7517056936566813833, guid: d85c8973fa3cab64e8410b1c1f9e03e4, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Igualmente\u2026 ehh\u2026"
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: 2fd71506cd35b37499404742fc662a69, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "Cairen. Puedes llamarme as\xED, sin formalidades. Es un placer
      tenerte aqu\xED."
    leftSpeaker: 1
    characterSprite: {fileID: 6775278750140180628, guid: 823f378d910b52d4ebc4f90954058405, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: Mira, justo ha sonado la campana de la comida.
    leftSpeaker: 1
    characterSprite: {fileID: 6775278750140180628, guid: 823f378d910b52d4ebc4f90954058405, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "Aqu\xED tenemos la costumbre de comer juntos, ya ver\xE1s que
      es m\xE1s agradable as\xED."
    leftSpeaker: 1
    characterSprite: {fileID: 6775278750140180628, guid: 823f378d910b52d4ebc4f90954058405, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "Y, bueno\u2026 si me haces un peque\xF1o favor, puedo conseguirte
      una doble raci\xF3n."
    leftSpeaker: 1
    characterSprite: {fileID: -7517056936566813833, guid: d85c8973fa3cab64e8410b1c1f9e03e4, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "Pero shhh, que quede entre nosotros, \xBFs\xED?"
    leftSpeaker: 1
    characterSprite: {fileID: -7517056936566813833, guid: d85c8973fa3cab64e8410b1c1f9e03e4, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
