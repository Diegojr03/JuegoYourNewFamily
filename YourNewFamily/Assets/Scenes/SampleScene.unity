--- !u!114 &1901991253
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1901991249}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58c785d1312487d48bae41c65e986f1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterLeft: {fileID: 1535509875}
  characterRight: {fileID: 2075877767}
  spriteLeft: {fileID: 1535509876}
  spriteRight: {fileID: 2075877768}
  defaultLeftSprite: {fileID: -1361755999665726283, guid: 2a057a50c2ff21d4d9f552fbece9e0a4, type: 3}
  defaultRightSprite: {fileID: -1674950913012282259, guid: a5603edeb1e5a3d45a5e2ebd1a655387, type: 3}
  dialoguePanel: {fileID: 1834269160}
  speakerText: {fileID: 1659188321}
  dialogueText: {fileID: 78300818}
  speakerContainer: {fileID: 1863344623}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogueId: 23f99274-9852-4d1d-a14c-1a2ba774be69
  dialogues:
  - speakerName: Bortis
    dialogueText: "\xBFQu\xE9 tal tu estancia Lilith? Espero que todo te est\xE9
      gustando"
    leftSpeaker: 1
    characterSprite: {fileID: -7668641986847109036, guid: 24da9c70df32a1841ae7af8729ad9ad1, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "La verdad que s\xED\u2026 no esperaba tanta amabilidad de vuestra
      parte"
    leftSpeaker: 0
    characterSprite: {fileID: 6377917850455477399, guid: b3555c8a1e4ebba4e84c64c3e0c1ec36, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Bortis
    dialogueText: "Aqu\xED todos somos familia, eso es lo de menos."
    leftSpeaker: 1
    characterSprite: {fileID: -7668641986847109036, guid: 24da9c70df32a1841ae7af8729ad9ad1, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Bortis
    dialogueText: Mira, necesito tu ayuda para que lleves esta cesta a algunos de
      tus nuevos hermanos y hermanas.
    leftSpeaker: 1
    characterSprite: {fileID: -7668641986847109036, guid: 24da9c70df32a1841ae7af8729ad9ad1, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Bortis
    dialogueText: "Pasa por la plaza central, la biblioteca y el jard\xEDn."
    leftSpeaker: 1
    characterSprite: {fileID: -7668641986847109036, guid: 24da9c70df32a1841ae7af8729ad9ad1, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Bortis
    dialogueText: "Piensa que esto te ayudar\xE1 a integrarte y a conocernos mejor."
    leftSpeaker: 1
    characterSprite: {fileID: -7668641986847109036, guid: 24da9c70df32a1841ae7af8729ad9ad1, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: 
    dialogueText: "Has conseguido: Cesta de v\xEDveres"
    leftSpeaker: 0
    characterSprite: {fileID: 0}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Me vendr\xE1 bien darme un paseo, ahora mismo voy para all\xE1."
    leftSpeaker: 0
    characterSprite: {fileID: 6377917850455477399, guid: b3555c8a1e4ebba4e84c64c3e0c1ec36, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
  inventoryItemName: Nuevo Item
