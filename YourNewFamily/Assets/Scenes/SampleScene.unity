--- !u!114 &1724160670
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1724160665}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58c785d1312487d48bae41c65e986f1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterLeft: {fileID: 558906526}
  characterRight: {fileID: 1654459073}
  spriteLeft: {fileID: 558906525}
  spriteRight: {fileID: 1654459072}
  dialoguePanel: {fileID: 1834269160}
  speakerText: {fileID: 1659188321}
  dialogueText: {fileID: 78300818}
  speakerContainer: {fileID: 1863344623}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 2
  dialogues:
  - speakerName: Peter
    dialogueText: "Estoy harto del curro, t\xEDo. Cada d\xEDa es lo mismo. Si no
      renuncio pronto, me van a encontrar muerto en esa oficina."
    leftSpeaker: 1
  - speakerName: Peter
    dialogueText: "Ey, Lilith\u2026 tengo de nuevo el producto que te gusta. Ya sabes,
      el de siempre."
    leftSpeaker: 1
  - speakerName: Peter
    dialogueText: "Cinco d\xF3lares el gramo. No te preocupes, es de buena calidad."
    leftSpeaker: 1
  - speakerName: Lilith
    dialogueText: "\xBFCinco d\xF3lares? Oye, recuerda que la \xFAltima vez te cubr\xED
      las espaldas cuando casi te pilla el casero en el pasillo."
    leftSpeaker: 0
  - speakerName: Peter
    dialogueText: Vale, vale, no hace falta que me eches en cara mis deudas.
    leftSpeaker: 1
  - speakerName: Peter
    dialogueText: "Toma, esta es por cuenta de la casa. Pero que no se te suba a
      la cabeza, \xBFeh?"
    leftSpeaker: 1
  - speakerName: 
    dialogueText: (obtienes bolsa de Nieve Negra)
    leftSpeaker: 0
