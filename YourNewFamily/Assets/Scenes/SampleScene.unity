  defaultRightSprite: {fileID: -1674950913012282259, guid: a5603edeb1e5a3d45a5e2ebd1a655387, type: 3}
  dialoguePanel: {fileID: 1834269160}
  speakerText: {fileID: 1659188321}
  dialogueText: {fileID: 78300818}
  speakerContainer: {fileID: 1863344623}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogueId: efa27e95-e354-4084-bf63-948d827bde46
  dialogues:
  - speakerName: Gamma
    dialogueText: "Anda Lilith, \xBFqu\xE9 tal vas con la gente?"
    leftSpeaker: 1
    characterSprite: {fileID: -4831706047985285938, guid: 06e3e07abd727584c8ebc7318360d8b6, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "La verdad que bastante bien, todos me tratan genial. Es como la
      sensaci\xF3n de sentirse en casa. \xBFY t\xFA?"
    leftSpeaker: 0
    characterSprite: {fileID: 6377917850455477399, guid: b3555c8a1e4ebba4e84c64c3e0c1ec36, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Gamma
    dialogueText: "Todav\xEDa me estoy adaptando a esto, eso s\xED,"
    leftSpeaker: 1
    characterSprite: {fileID: -4831706047985285938, guid: 06e3e07abd727584c8ebc7318360d8b6, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Gamma
    dialogueText: "he escuchado rumores de un n\xE9ctar que te quita el mono y ahora
      mismo estoy con mucha necesidad."
    leftSpeaker: 1
    characterSprite: {fileID: -4831706047985285938, guid: 06e3e07abd727584c8ebc7318360d8b6, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Gamma
    dialogueText: Puf, necesito ir a probarlo, estoy que no me mantengo en pie.
    leftSpeaker: 1
    characterSprite: {fileID: -4831706047985285938, guid: 06e3e07abd727584c8ebc7318360d8b6, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
