  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f69405e443069f544b51770be0c0f5f6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueId: 8e0986a9-ca5d-447d-8668-991cc41bd64d
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
  inventoryItemName: Nuevo Item
  textSpeed: 0.05
  autoActivate: 0
  guardarEnBacklog: 0
  dialogueSections:
  - speakerName: Boris
    dialogueText: "Hermanos y hermanas, bienvenidos a casa. Aqu\xED dej\xE1is atr\xE1s
      el mundo que os dio la espalda."
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Boris
    dialogueText: "Aqu\xED, vuestro trabajo tiene prop\xF3sito, y vuestra vida, valor.
      Sois familia."
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Boris
    dialogueText: "Se os proporcionar\xE1 una vivienda compartida para vosotros.
      Pod\xE9is poneros c\xF3modos cuando entr\xE9is."
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Boris
    dialogueText: Por favor id yendo a la zona de las casas.
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
