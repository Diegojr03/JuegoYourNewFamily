--- !u!114 &1298936425
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1298936423}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f69405e443069f544b51770be0c0f5f6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueId: 3b7965bb-3121-4d66-8e87-b28f5391cdb5
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
  inventoryItemName: Nuevo Item
  textSpeed: 0.05
  autoActivate: 0
  guardarEnBacklog: 0
  dialogueSections:
  - speakerName: Alpha
    dialogueText: "\xA1Calma, hermanos! Mantengan la compostura. Delta se est\xE1
      encargando."
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: 'Un desafortunado accidente con una roca suelta en el camino... '
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: Estamos buscando en la zona para asegurar que no ha pasado nada
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Beta ha llamado a Bortis a su lado. No fue en vano; su partida
      nos recuerda que incluso aqu\xED, debemos ser cuidadosos."
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Que su sacrificio nos una m\xE1s. Silas se encargar\xE1 de preparar
      el cuerpo para el ritual de despedida."
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Por favor, regresen a sus caba\xF1as y recen por su alma."
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: NPC
    dialogueText: "\xA1Por todos los santos! \xC9l... \xE9l me ayud\xF3 a tejer apenas
      ayer... Qu\xE9 destino tan cruel."
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  dialoguePanel: {fileID: 1834269160}
  speakerContainer: {fileID: 1863344623}
  speakerText: {fileID: 1659188321}
  dialogueText: {fileID: 78300818}
  promptOffset: {x: 0, y: 1, z: 0}
  dialogueSound: {fileID: 0}
  destroyAfterDialogue: 1
  objectsToActivateAfter:
  - {fileID: 889647434}
  - {fileID: 765213027}
  - {fileID: 145471985}
  objectsToDestroyAfter: []
