--- !u!114 &453982327
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 453982321}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58c785d1312487d48bae41c65e986f1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterLeft: {fileID: 2146275056}
  characterRight: {fileID: 1229006930}
  spriteLeft: {fileID: 2146275055}
  spriteRight: {fileID: 1229006931}
  defaultLeftSprite: {fileID: -898178471685318745, guid: f0df01d5aa899804c9cdfba99798377c, type: 3}
  defaultRightSprite: {fileID: -1674950913012282259, guid: a5603edeb1e5a3d45a5e2ebd1a655387, type: 3}
  dialoguePanel: {fileID: 1834269160}
  speakerText: {fileID: 1659188321}
  dialogueText: {fileID: 78300818}
  speakerContainer: {fileID: 1863344623}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogueId: MaryYLilith
  dialogues:
  - speakerName: Mary
    dialogueText: "\xA1Ey, Lilith! \xBFC\xF3mo lo llevas? D\xE9jame adivinar\u2026
      \xBFel casero volvi\xF3 a pasar a ofrecerte trabajar para \xE9l? "
    leftSpeaker: 1
    characterSprite: {fileID: 5465866427460756199, guid: 0847a9c8166a9a34da3b89f71a02c6a9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Mary
    dialogueText: "Te dir\xE9 algo, paga bastante bien, pero\u2026 bueno, ya sabes,
      es un trabajo pesado. Jajaja"
    leftSpeaker: 1
    characterSprite: {fileID: 5465866427460756199, guid: 0847a9c8166a9a34da3b89f71a02c6a9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Mary
    dialogueText: "Por cierto, esta noche voy al bar nuevo de la esquina. Si te apetece
      despejarte un rato, nos vemos all\xED."
    leftSpeaker: 1
    characterSprite: {fileID: 5465866427460756199, guid: 0847a9c8166a9a34da3b89f71a02c6a9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Mary
    dialogueText: "Aqu\xED tienes una nota con las indicaciones para llegar, no vaya
      a ser que te pierdas."
    leftSpeaker: 1
    characterSprite: {fileID: 5465866427460756199, guid: 0847a9c8166a9a34da3b89f71a02c6a9, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Gracias\u2026 quiz\xE1 me pase. Al fin y al cabo, no tengo nada
      mejor que hacer."
    leftSpeaker: 0
    characterSprite: {fileID: 6377917850455477399, guid: b3555c8a1e4ebba4e84c64c3e0c1ec36, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
