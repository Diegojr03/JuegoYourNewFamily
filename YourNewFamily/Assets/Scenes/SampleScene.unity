MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1319324203}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f69405e443069f544b51770be0c0f5f6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueId: ConvConCuchillo
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
  inventoryItemName: Nuevo Item
  textSpeed: 0.05
  autoActivate: 1
  guardarEnBacklog: 1
  dialogueSections:
  - speakerName: Lilith
    dialogueText: "\xA1Esc\xFAchame bien! No vuelvas a amenazarme. Ya te dije que
      cuando tenga el dinero, lo tendr\xE1s."
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Hasta entonces\u2026 espera. Y deja de molestarme."
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Casero
    dialogueText: "\xBFCrees que puedes intimidarme?"
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Casero
    dialogueText: "Tienes una semana m\xE1s\u2026 si no, te saco de aqu\xED aunque
      tenga que hacerlo yo mismo."
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Ser\xE1 suficiente. Y ahora qu\xEDtate de mi puerta."
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "(Madre m\xEDa... por fin podr\xE9 salir)"
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  dialoguePanel: {fileID: 1834269160}
  speakerContainer: {fileID: 1863344623}
  speakerText: {fileID: 1659188321}
