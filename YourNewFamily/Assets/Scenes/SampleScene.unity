--- !u!114 &1288447
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1288443}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58c785d1312487d48bae41c65e986f1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterLeft: {fileID: 410075400}
  characterRight: {fileID: 1538476114}
  spriteLeft: {fileID: 410075399}
  spriteRight: {fileID: 1538476113}
  dialoguePanel: {fileID: 1834269160}
  speakerText: {fileID: 1659188321}
  dialogueText: {fileID: 78300818}
  speakerContainer: {fileID: 1863344623}
  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogues:
  - speakerName: Trapero
    dialogueText: "\xBFQu\xE9 haces aqu\xED fuera empapada? No me digas que el grandote
      de la puerta no te deja entrar\u2026 jajaja"
    leftSpeaker: 1
  - speakerName: Trapero
    dialogueText: "Si quieres, puedo montar un esc\xE1ndalo."
    leftSpeaker: 1
  - speakerName: Trapero
    dialogueText: "Ya sabes, gritar, fingir que me desmayo o romper una botella\u2026
      lo que elijas."
    leftSpeaker: 1
  - speakerName: Trapero
    dialogueText: "Pero eso s\xED, no trabajo gratis. \xBFNo tendr\xE1s por ah\xED
      algo de ese nuevo producto que te deja volando?"
    leftSpeaker: 1
  - speakerName: Lilith
    dialogueText: "Pues no, no tengo nada de eso que tu dices que te deja volando,
      si no ya me lo hubiese tomado yo\u2026 jajaja"
    leftSpeaker: 0
  - speakerName: Trapero
    dialogueText: "Venga va, por unos 5 d\xF3lares monto un esc\xE1ndalo y me llevo
      al segurata."
    leftSpeaker: 1
  - speakerName: Lilith
    dialogueText: "Te vendes muy caro, \xBFqu\xE9 te crees, piensas que soy un cajero?"
    leftSpeaker: 0
  - speakerName: Lilith
    dialogueText: "Ugh\u2026 bueno, me lo quiero pasar bien as\xED que toma."
    leftSpeaker: 0
  - speakerName: 
    dialogueText: "(Entregas 5 d\xF3lares)"
    leftSpeaker: 0
  - speakerName: Trapero
    dialogueText: "Muy bien, cruza a la otra acera y ver\xE1s la magia"
    leftSpeaker: 1
  objectsToActivateAfter:
  - {fileID: 2108206131}
  objectsToDestroyAfter: []
  destroyAfterDialogue: 1
  autoActivate: 0
