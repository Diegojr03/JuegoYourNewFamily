--- !u!114 &88194352
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 88194345}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f69405e443069f544b51770be0c0f5f6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textSpeed: 0.05
  autoActivate: 1
  autoAdvanceTime: 2
  dialogueSections:
  - speakerName: ??
    dialogueText: "\xBFTe fijaste en ese sem\xE1foro? A veces parece que se enciende
      solo\u2026 como si todav\xEDa funcionara."
  - speakerName: ???
    dialogueText: "S\xED. Lo curioso es que la luz roja se queda m\xE1s tiempo. "
  - speakerName: ???
    dialogueText: Creo que la vi parpadear dos veces antes de cambiar.
  - speakerName: ??
    dialogueText: "\xBFDos veces? Qu\xE9 raro. Yo cont\xE9 solo una vez el verde
      despu\xE9s de eso."
  - speakerName: ???
    dialogueText: "Antes de que se pagasen creo que el amarillo tambi\xE9n se encendi\xF3
      bastantes veces"
  - speakerName: ???
    dialogueText: "Bah, seguro es solo un fallo el\xE9ctrico"
  - speakerName: ??
    dialogueText: "S\xED, adem\xE1s empieza a hacer fr\xEDo. Ojal\xE1 encontremos
      algo abierto para tomar algo"
  dialoguePanel: {fileID: 1834269160}
  speakerContainer: {fileID: 1863344623}
  speakerText: {fileID: 1659188321}
  dialogueText: {fileID: 78300818}
