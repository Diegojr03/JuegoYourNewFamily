--- !u!114 &1123262001
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1123261999}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f69405e443069f544b51770be0c0f5f6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueId: NPCSConversacionRepetitivo
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
  inventoryItemName: Nuevo Item
  textSpeed: 0.05
  autoActivate: 0
  guardarEnBacklog: 0
  dialogueSections:
  - speakerName: ??
    dialogueText: "\xBFTe fijaste en esos sem\xE1foros? A veces parece que se encienden
      solos\u2026 como si todav\xEDa funcionaran."
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: ???
    dialogueText: "S\xED. Lo curioso es que la luz roja parpadea en m\xE1s sem\xE1foros. "
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: ???
    dialogueText: "Creo que la vi parpadear dos veces en dos sem\xE1foros diferentes."
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: ??
    dialogueText: "\xBFDos veces? Qu\xE9 raro. Yo cont\xE9 solo una vez el verde
      despu\xE9s de eso."
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: ???
    dialogueText: "Antes de que se apagasen vi que el amarillo tambi\xE9n se encendi\xF3
      en bastantes sem\xE1foros."
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: ???
    dialogueText: "Bah, seguro es solo un fallo el\xE9ctrico"
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: ??
    dialogueText: "S\xED, adem\xE1s empieza a hacer fr\xEDo. Ojal\xE1 encontremos
      algo abierto para tomar algo"
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  dialoguePanel: {fileID: 1834269160}
  speakerContainer: {fileID: 1863344623}
  speakerText: {fileID: 1659188321}
  dialogueText: {fileID: 78300818}
  promptOffset: {x: 0, y: 1, z: 0}
  dialogueSound: {fileID: 0}
  destroyAfterDialogue: 0
  objectsToActivateAfter: []
  objectsToDestroyAfter: []
