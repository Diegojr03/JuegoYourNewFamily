  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f69405e443069f544b51770be0c0f5f6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textSpeed: 0.05
  autoActivate: 0
  autoAdvanceTime: 1
  dialogueSections:
  - speakerName: Lilith
    dialogueText: "Esto me vale\u2026 aunque... genial, es la \xFAltima. Tendr\xE9
      que comprar m\xE1s tarde. "
  - speakerName: Lilith
    dialogueText: "Supongo que el supermercado ser\xE1 mi \xFAnico plan para hoy.
      Pero bueno, ya ir\xE9 m\xE1s tarde. "
  - speakerName: Lilith
    dialogueText: "Por ahora me tumbar\xE9 a ver algo."
