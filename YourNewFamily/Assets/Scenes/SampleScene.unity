  moveSpeed: 5
  dialogueCooldown: 0.05
  horizontalOffsetPercent: 0.4
  verticalOffsetPercent: 0.2
  autoAdvanceTime: 1.5
  dialogueId: 75932c1a-3843-40a3-83c5-610894606d04
  dialogues:
  - speakerName: Cairen
    dialogueText: "Perdona, Lilith. Acabo de ver a Alpha, y me ha pedido que te avise
      de que te est\xE1 esperando en la plaza."
    leftSpeaker: 1
    characterSprite: {fileID: 6775278750140180628, guid: 823f378d910b52d4ebc4f90954058405, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: No parece nada grave, tranquila, solo quiere hablar contigo un
      momento.
    leftSpeaker: 1
    characterSprite: {fileID: 6775278750140180628, guid: 823f378d910b52d4ebc4f90954058405, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Cairen
    dialogueText: "Ser\xE1 mejor que vayas, no le gusta que le hagan esperar, ya
      sabes c\xF3mo es."
    leftSpeaker: 1
    characterSprite: {fileID: 6775278750140180628, guid: 823f378d910b52d4ebc4f90954058405, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Ah\u2026 claro. No quiero hacerle esperar. Gracias, Cairen."
    leftSpeaker: 0
    characterSprite: {fileID: 5953301182136891594, guid: 2fd71506cd35b37499404742fc662a69, type: 3}
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
