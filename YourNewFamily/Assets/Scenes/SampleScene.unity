--- !u!114 &1076594704
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1076594699}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dbc22598762463945aebb97aba4847d6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueId: d17a5548-8017-4787-8d9d-b3b5278c1e3f
  protagonistName: Lilith
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
  inventoryItemName: Nuevo Item
  dialogueLines:
  - speakerName: Alpha
    dialogueText: "Lilith. Justo pensaba en ti. Espero que est\xE9s encontrando la
      paz que mereces en nuestro hogar"
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 0
    choices:
    - choiceText: "A) Si, la verdad, no recordaba c\xF3mo se sent\xEDa la tranquilidad."
      nextDialogueIndex: 1
    - choiceText: "B) S\xED, todo el mundo ha sido muy amable."
      nextDialogueIndex: 1
    - choiceText: C) Es un lugar muy organizado.
      nextDialogueIndex: 1
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: La familia es el pilar de todo.
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Para que una familia funcione, se necesita orden, por supuesto,
      pero tambi\xE9n estructura."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: Por eso quiero presentarte a Delta.
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Es mi brazo derecho y el coordinador de todo lo que ves funcionar
      aqu\xED. "
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Si alg\xFAn d\xEDa no me encuentras, b\xFAscale a \xE9l."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Es la persona m\xE1s eficiente que conocer\xE1s."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Delta
    dialogueText: "Es un procedimiento est\xE1ndar. Conocer a los nuevos miembros."
    leftSpeaker: 1
    characterSprite: {fileID: -311131714167770203, guid: 97fa321f5b36dfa46bc8e7c875e1c5c3, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Delta
    dialogueText: Evaluar sus... capacidades. Es conveniente para asignarles las
      tareas donde mejor se adapten.
    leftSpeaker: 1
    characterSprite: {fileID: -311131714167770203, guid: 97fa321f5b36dfa46bc8e7c875e1c5c3, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: No le hagas caso, siempre tan formal.
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Lo que Delta quiere decir es que nos aseguramos de que todos est\xE9n
      c\xF3modos y sean productivos."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "\xC9l se encarga de que el huerto tenga herramientas, que las
      caba\xF1as est\xE9n en pie y bueno..."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: de que no haya contratiempos en general.
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "La seguridad y el orden son primordiales aqu\xED, lejos del caos
      del mundo."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Delta
    dialogueText: "El orden previene el caos, la disciplina y el sufrimiento. Aqu\xED
      no hay lugar para accidentes"
    leftSpeaker: 1
    characterSprite: {fileID: -311131714167770203, guid: 97fa321f5b36dfa46bc8e7c875e1c5c3, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Exactamente. Delta es nuestro guardi\xE1n. Un pilar de fuerza."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "T\xFA tambi\xE9n podr\xEDas serlo, Lilith. Tienes esa chispa.
      Una fuerza que el mundo exterior no supo apreciar."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "\xBFVes, Delta? Esta chica tiene potencial \xBFNo lo crees?\r"
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Delta
    dialogueText: "El potencial se demuestra con acciones, no con palabras. Ya veremos
      qu\xE9 tal lo hace la reci\xE9n llegada."
    leftSpeaker: 1
    characterSprite: {fileID: -311131714167770203, guid: 97fa321f5b36dfa46bc8e7c875e1c5c3, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Que no te intimide su... frialdad. Los hombres como Delta son
      los cimientos sobre los que construimos el para\xEDso."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 0
    choices: []
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Alpha
    dialogueText: "Son necesarios. Ahora, ve, disfruta del d\xEDa. Nuestra familia
      te necesita descansada."
    leftSpeaker: 1
    characterSprite: {fileID: -273775725430403696, guid: 72d165fe6685fc641b687376541b7cb9, type: 3}
    endDialogueHere: 0
    choices:
    - choiceText: "A) Encantada\u2026 supongo que tiene mucho trabajo, con todo lo
        que hay que mantener en orden aqu\xED."
      nextDialogueIndex: 22
    - choiceText: B) Un placer, Delta. Espero no ser una molestia.
      nextDialogueIndex: 22
    - choiceText: "C) Parece que aqu\xED cada cosa tiene su sitio. Me alegra que
        alguien se asegure de eso."
      nextDialogueIndex: 22
