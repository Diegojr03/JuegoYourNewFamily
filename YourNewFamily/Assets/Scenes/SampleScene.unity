  guardarEnBacklog: 1
  dialogueSections:
  - speakerName: Lilith
    dialogueText: "Que bien huelen, me recuerdan a cuando las cosas eran m\xE1s simples.
      Espero que esto me de una nueva vida."
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Mi madre sol\xEDa poner estas flores en mi ventana, dec\xEDa que
      espantaban la tristeza. "
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: Cuantos buenos recuerdos tengo de ella.
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
