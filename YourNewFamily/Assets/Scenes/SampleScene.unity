--- !u!114 &1390948124
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1390948122}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f69405e443069f544b51770be0c0f5f6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueId: c0078263-613c-4b1c-81d8-a4d3335c33ab
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
  inventoryItemName: Nuevo Item
  textSpeed: 0.05
  autoActivate: 0
  guardarEnBacklog: 0
  dialogueSections:
  - speakerName: Lilith
    dialogueText: "\xBFNo me lo pod\xEDan decir directamente? En fin\u2026 a ver
      que pone en la nota"
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: 
    dialogueText: '*Cuatro guardianes velan tu descanso,

      bajo sus sombras
      descansa lo que necesitas.

'
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: 
    dialogueText: 'El primero susurra en el viento callado,

      la Hoja conoce
      senderos olvidados.

'
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: 
    dialogueText: 'Luego busca el fuego que nunca muere,

      la Llama que quema
      lo impuro.

'
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: 
    dialogueText: "En tercer lugar mira donde nace el d\xEDa,\r\nall\xED el Sol despierta
      y todo ilumina.\r\n"
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: 
    dialogueText: 'Y al final, donde la noche abraza el mundo,

      la Luna vigila
      el destino profundo.

'
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: 
    dialogueText: "Solo si sigues el orden,\r\nlo que necesitas ser\xE1 revelado.\r\n"
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Bueno, mirar\xE9 por aqu\xED a ver que encuentro"
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  dialoguePanel: {fileID: 1834269160}
  speakerContainer: {fileID: 1863344623}
  speakerText: {fileID: 1659188321}
  dialogueText: {fileID: 78300818}
  promptOffset: {x: 0, y: 1, z: 0}
  dialogueSound: {fileID: 0}
  destroyAfterDialogue: 0
  objectsToActivateAfter: []
  objectsToDestroyAfter: []
