  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 176374043}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f69405e443069f544b51770be0c0f5f6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueId: ConvSinCuchillo
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
  inventoryItemName: Nuevo Item
  textSpeed: 0.05
  autoActivate: 1
  guardarEnBacklog: 1
  dialogueSections:
  - speakerName: Casero
    dialogueText: "Le he dado otra vuelta al asunto y \xA1ESTOY HARTO DE TI!"
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Casero
    dialogueText: "\xA1SEGUIRE AQUI HASTA QUE TE VAYAS!"
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "\xA1Oye! No hace falta que rompas la puerta."
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: Ya te dije que en cuanto tenga el dinero te voy a pagar. No estoy
      huyendo de nada.
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Casero
    dialogueText: "\xA1NO VOY A ESPERAR M\xC1S! \u2026 "
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Casero
    dialogueText: "Claro, eso es si no quieres empezar a trabajar para m\xED\u2026
      como las dem\xE1s."
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "(Que asco... No pienso ser como 'las dem\xE1s')"
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "(Tengo que salir de aqu\xED... Y r\xE1pido. \xBFPero c\xF3mo?,
      buscar\xE9 algo en mi habitaci\xF3n)"
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  dialoguePanel: {fileID: 1834269160}
  speakerContainer: {fileID: 1863344623}
  speakerText: {fileID: 1659188321}
  dialogueText: {fileID: 78300818}
  promptOffset: {x: 0, y: 0.5, z: 0}
