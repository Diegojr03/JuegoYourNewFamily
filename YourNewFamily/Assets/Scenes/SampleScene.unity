  autoAdvanceTime: 1.5
  dialogueSections:
  - speakerName: Casero
    dialogueText: "\xA1SE QUE EST\xC1S AHI DENTRO! \xA1SAL A PAGAR EL ALQUILER!"
  - speakerName: Casero
    dialogueText: "\xA1LLEVAS MESES DE RETRASO Y NO VOY A PERMITIR QUE SIGAS AQUI!"
  - speakerName: Casero
    dialogueText: "\xA1LLAMARE A LA POLICIA!\n"
  - speakerName: Lilith
    dialogueText: "Qu\xE9 pesado\u2026 \xBFAcaso no tiene otra cosa que hacer en
      su vida?"
  - speakerName: Lilith
    dialogueText: "\xBFHasta cu\xE1ndo piensa estar ah\xED plantado?"
