  m_Script: {fileID: 11500000, guid: f69405e443069f544b51770be0c0f5f6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textSpeed: 0.05
  autoActivate: 1
  autoAdvanceTime: 1.5
  dialogueSections:
  - speakerName: Casero
    dialogueText: "Le he dado otra vuelta al asunto y \xA1ESTOY HARTO DE TI!"
  - speakerName: Casero
    dialogueText: "\xA1SEGUIRE AQUI HASTA QUE TE VAYAS!"
  - speakerName: Lilith
    dialogueText: "\xA1Oye! No hace falta que rompas la puerta."
  - speakerName: Lilith
    dialogueText: Ya te dije que en cuanto tenga el dinero te voy a pagar. No estoy
      huyendo de nada.
  - speakerName: Casero
    dialogueText: "\xA1NO VOY A ESPERAR M\xC1S! \u2026 "
  - speakerName: Casero
    dialogueText: "Claro, eso es si no quieres empezar a trabajar para m\xED\u2026
      como las dem\xE1s."
  - speakerName: Lilith
    dialogueText: "(Que asco... No pienso ser como 'las dem\xE1s')"
  - speakerName: Lilith
    dialogueText: "(Tengo que salir de aqu\xED... Y r\xE1pido. \xBFPero c\xF3mo?,
      buscar\xE9 algo en mi habitaci\xF3n)"
