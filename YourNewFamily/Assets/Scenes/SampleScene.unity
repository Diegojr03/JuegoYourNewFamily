  dialogueSections:
  - speakerName: Lilith
    dialogueText: "Que rara me siento aqu\xED, es como si algo me estuviese llamando
      o haciendo una se\xF1al."
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "\xBFEs esto lo que me dijo antes Alpha?"
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "La semilla que me di\xF3 antes es rara, brilla de una manera extra\xF1a."
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: Lilith
    dialogueText: "Seguramente es aqu\xED donde tengo que plantarla"
