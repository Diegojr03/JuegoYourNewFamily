    itemIconToGive: {fileID: 0}
  - speakerName: Jorah
    dialogueText: "Me ha dicho Cairen que te d\xE9 un poco m\xE1s de lo que le doy
      a los dem\xE1s. Pues aqu\xED tienes, disfrutalo."
    leftSpeaker: 1
    characterSprite: {fileID: -6705544094370837958, guid: 616f3a2a46c871342bcb37e4215aed2f, type: 3}
