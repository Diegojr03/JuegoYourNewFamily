MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 558244581}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f69405e443069f544b51770be0c0f5f6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemToAddToInventory: {fileID: 0}
  inventoryItemIcon: {fileID: 0}
  inventoryItemId: item_default
  inventoryItemName: Nuevo Item
  textSpeed: 0.05
  autoActivate: 1
  dialogueSections:
  - speakerName: 
    dialogueText: Claro... ahora lo veo. Alpha hablaba de Beta como si fuera un dios.
      Como si fuera alguien que iba a venir.
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: 
    dialogueText: "Pero no. No estaba esperando a nadie. Siempre estuvo ah\xED. Desde
      el principio. No era Alpha quien nos guiaba."
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: 
    dialogueText: "Eres t\xFA. Beta eres t\xFA. T\xFA elegiste. T\xFA empujaste todo
      esto. Y yo solo era la que lo hac\xEDa. As\xED que esc\xFAchame bien."
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  - speakerName: 
    dialogueText: "Porque ahora s\xE9 que est\xE1s ah\xED. Y cuando te encuentre\u2026
      T\xFA ser\xE1s el siguiente."
    giveItemAfterThisLine: 0
    itemIdToGive: 
    itemNameToGive: 
    itemIconToGive: {fileID: 0}
  dialoguePanel: {fileID: 669541268}
  speakerContainer: {fileID: 268610414}
  speakerText: {fileID: 240915352}
